{% extends 'base.html.twig' %}

{% block title %}Code par email{% endblock %}

{% block auth_body %}
<div class="auth-wrapper">
    <div class="auth-card">

        <div style="margin-bottom:24px;">
            <a href="{{ path('app_password_reset_method') }}" style="color:var(--text-muted);display:inline-flex;align-items:center;gap:5px;font-size:.82rem;margin-bottom:20px;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5m7-7l-7 7 7 7"/></svg>
                Retour
            </a>
            <div style="width:48px;height:48px;background:rgba(99,102,241,.1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
                <svg width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </div>
            <div style="font-size:1.1rem;font-weight:800;color:var(--text-primary);margin-bottom:4px;">Recevoir un code par email</div>
            <div style="font-size:.84rem;color:var(--text-secondary);line-height:1.5;">
                Confirmez votre adresse email ({{ masked_email }}) pour recevoir un code de vérification à 6 chiffres, valable 15 minutes.
            </div>
        </div>

        <form method="post" action="{{ path('app_password_reset_email_code_send') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_email_code_send') }}">

            <div class="form-group">
                <label for="email">Votre adresse email</label>
                <input class="form-control" type="email" id="email" name="email" placeholder="vous@exemple.com" required autofocus>
                <div class="form-hint">Saisissez l'adresse email exacte associée à votre compte.</div>
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:8px;">
                Envoyer le code
            </button>
        </form>

    </div>
</div>
{% endblock %}