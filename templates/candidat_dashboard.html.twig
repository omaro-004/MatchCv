{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Bienvenue, {{ app.user.profilCandidat is not null ? app.user.profilCandidat.nomComplet|split(' ')|first : 'Candidat' }} 👋{% endblock %}
{% block page_subtitle %}Voici un aperçu réel de votre activité sur MatchCV{% endblock %}

{% block body %}

<style>
    .candidate-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        padding: 28px;
        margin-bottom: 24px;
        background:
            radial-gradient(circle at top left, rgba(255,255,255,.22), transparent 28%),
            linear-gradient(135deg, rgba(251,113,133,.95) 0%, rgba(249,115,22,.92) 42%, rgba(59,130,246,.92) 100%);
        color: #fff;
        box-shadow: 0 24px 48px rgba(15,23,42,.16);
    }
    .candidate-hero::before,
    .candidate-hero::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(12px);
    }
    .candidate-hero::before {
        width: 220px;
        height: 220px;
        background: rgba(255,255,255,.14);
        top: -80px;
        right: -40px;
    }
    .candidate-hero::after {
        width: 160px;
        height: 160px;
        background: rgba(255,255,255,.10);
        left: 34%;
        bottom: -72px;
    }
    .candidate-hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(280px, .9fr);
        gap: 22px;
        align-items: end;
    }
    .candidate-hero-copy h2 {
        margin: 8px 0 10px;
        font-size: clamp(1.8rem, 3vw, 3rem);
        line-height: 1.02;
        letter-spacing: -.05em;
    }
    .candidate-hero-copy p {
        margin: 0;
        max-width: 56ch;
        color: rgba(255,255,255,.88);
        font-size: .96rem;
        line-height: 1.7;
    }
    .candidate-hero-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }
    .candidate-hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.18);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
    }
    .candidate-hero-panel {
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 22px;
        padding: 18px;
        backdrop-filter: blur(16px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.2);
    }
    .candidate-hero-panel .panel-kpi {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 12px;
    }
    .candidate-hero-panel .panel-kpi div {
        padding: 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.14);
    }
    .candidate-hero-panel .panel-kpi strong {
        display: block;
        font-size: 1.35rem;
        line-height: 1;
        margin-bottom: 4px;
    }
    .candidate-hero-panel .panel-kpi span {
        font-size: .76rem;
        color: rgba(255,255,255,.82);
    }
    .candidate-hero-panel .panel-note {
        margin-top: 14px;
        font-size: .85rem;
        color: rgba(255,255,255,.88);
        line-height: 1.55;
    }
    @media (max-width: 960px) {
        .candidate-hero-grid { grid-template-columns: 1fr; }
    }
</style>

<section class="candidate-hero">
    <div class="candidate-hero-grid">
        <div class="candidate-hero-copy">
            <div class="badge badge-neutral" style="background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.18);">Espace candidat</div>
            <h2>Votre parcours mérite une vitrine plus vivante.</h2>
            <p>Explorez les offres, suivez vos candidatures et améliorez votre profil dans une interface plus expressive, plus lumineuse et plus rapide à lire.</p>
            <div class="candidate-hero-pills">
                <span class="candidate-hero-pill">📌 Matchs personnalisés</span>
                <span class="candidate-hero-pill">⚡ Réponses rapides</span>
                <span class="candidate-hero-pill">🎯 Candidatures suivies</span>
            </div>
        </div>
        <div class="candidate-hero-panel">
            <div class="panel-kpi">
                <div>
                    <strong>{{ stats.offres_disponibles }}</strong>
                    <span>offres pour vous</span>
                </div>
                <div>
                    <strong>{{ stats.candidatures_totales }}</strong>
                    <span>candidatures envoyées</span>
                </div>
                <div>
                    <strong>{{ stats.offres_nouvelles_semaine }}</strong>
                    <span>nouvelles cette semaine</span>
                </div>
                <div>
                    <strong>{{ stats.score_matching_moyen is not null ? stats.score_matching_moyen ~ '%' : '—' }}</strong>
                    <span>score moyen</span>
                </div>
            </div>
            <div class="panel-note">Votre espace s’adapte à votre activité pour rendre les actions prioritaires plus visibles.</div>
        </div>
    </div>
</section>

<style>
    .completion-banner {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        border-radius: var(--radius-lg);
        padding: 22px 26px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .completion-banner.complete {
        background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
    }
    .completion-ring {
        position: relative;
        width: 84px;
        height: 84px;
        border-radius: 50%;
        flex-shrink: 0;
        background: conic-gradient(#fff {{ stats.profil_completion.pourcentage }}%, rgba(255,255,255,.25) 0);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .completion-ring::before {
        content: '';
        position: absolute;
        width: 66px;
        height: 66px;
        border-radius: 50%;
        background: inherit;
        background: transparent;
    }
    .completion-ring-inner {
        position: relative;
        width: 66px;
        height: 66px;
        border-radius: 50%;
        background: rgba(0,0,0,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.05rem;
    }
    .completion-content { flex: 1; min-width: 220px; }
    .completion-content h3 { font-size: 1.05rem; font-weight: 800; margin-bottom: 4px; }
    .completion-content p { font-size: .84rem; opacity: .92; margin-bottom: 12px; }
    .completion-checklist { display: flex; flex-wrap: wrap; gap: 8px; }
    .completion-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 999px;
        font-size: .74rem; font-weight: 600;
        background: rgba(255,255,255,.16);
    }
    .completion-chip.done { background: rgba(255,255,255,.28); }
    .completion-chip svg { width: 12px; height: 12px; flex-shrink: 0; }

    .reco-score {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 11px; border-radius: 999px;
        font-size: .78rem; font-weight: 700;
    }
    .reco-score.high { background: rgba(34,197,94,.12); color: #16a34a; }
    .reco-score.mid  { background: rgba(245,158,11,.12); color: #d97706; }
    .reco-score.low  { background: rgba(239,68,68,.12); color: #dc2626; }
    .reco-score.na   { background: var(--surface-2); color: var(--text-muted); border: 1px solid var(--border); }
</style>

{# ── BANNIÈRE DE COMPLÉTUDE DU PROFIL (façon "Profile Strength") ── #}
<div class="completion-banner {{ stats.profil_completion.pourcentage == 100 ? 'complete' : '' }}">
    <div class="completion-ring">
        <div class="completion-ring-inner">{{ stats.profil_completion.pourcentage }}%</div>
    </div>
    <div class="completion-content">
        {% if stats.profil_completion.pourcentage == 100 %}
            <h3>Profil complet ✓</h3>
            <p>Votre profil est optimisé — les recruteurs voient l'ensemble de vos informations.</p>
        {% else %}
            <h3>Complétez votre profil pour de meilleurs matchs</h3>
            <p>Un profil complet augmente vos chances d'être repéré par les recruteurs.</p>
        {% endif %}
        <div class="completion-checklist">
            {% for element in stats.profil_completion.elements %}
                <span class="completion-chip {{ element.complete ? 'done' : '' }}">
                    {% if element.complete %}
                        <svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    {% else %}
                        <svg fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    {% endif %}
                    {{ element.label }}
                </span>
            {% endfor %}
        </div>
    </div>
    <a href="{{ path('app_profil_candidat_edit') }}" class="btn btn-secondary" style="background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.3);color:#fff;flex-shrink:0;">
        Compléter mon profil
    </a>
</div>

{# ── KPI CARDS (réels) ── #}
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Offres pour vous</span>
            <div class="stat-card-icon accent">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 13.255A23.931 23.931 0 0 1 12 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2m4 6h.01M5 20h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.offres_disponibles }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">Correspondant à votre type de contrat</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Nouvelles cette semaine</span>
            <div class="stat-card-icon warning">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.offres_nouvelles_semaine }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">Publiées sur la plateforme (7 derniers jours)</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Candidatures envoyées</span>
            <div class="stat-card-icon success">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.candidatures_totales }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">Toutes offres confondues</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Score moyen de matching</span>
            <div class="stat-card-icon info">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.score_matching_moyen is not null ? stats.score_matching_moyen ~ '%' : '—' }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">{{ stats.score_matching_moyen is not null ? 'Basé sur vos candidatures scorées' : 'Aucune candidature scorée pour le moment' }}</div>
    </div>
</div>

{# ── GRAPHIQUES (réels) ── #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:24px;">

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Offres actives sur la plateforme — par type de contrat</div>
        {% if stats.offres_par_type_contrat|length > 0 and (stats.offres_par_type_contrat.stage > 0 or stats.offres_par_type_contrat.emploi > 0) %}
            <canvas id="chart-type-contrat" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Aucune offre active sur la plateforme pour le moment</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Offres actives — par mode de travail</div>
        {% if stats.offres_par_mode_travail|length > 0 and (stats.offres_par_mode_travail.sur_site > 0 or stats.offres_par_mode_travail.teletravail > 0 or stats.offres_par_mode_travail.hybride > 0) %}
            <canvas id="chart-mode-travail" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Aucune offre active sur la plateforme pour le moment</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Mes candidatures par statut</div>
        {% if stats.candidatures_totales > 0 %}
            <canvas id="chart-candidatures-statut" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Vous n'avez pas encore postulé à une offre</div>
        {% endif %}
    </div>

</div>

{# ── OFFRES RECOMMANDÉES POUR VOUS ── #}
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <div>
        <div class="section-title">Offres recommandées pour vous</div>
        <div class="section-subtitle">Scores calculés par la même IA que celle utilisée pour vos candidatures</div>
    </div>
</div>

{% if stats.offres_recommandees|length == 0 %}
    <div class="card" style="padding:40px 24px;text-align:center;margin-bottom:24px;">
        <div style="font-size:1.8rem;margin-bottom:10px;">🔍</div>
        <div style="font-weight:700;font-size:.95rem;margin-bottom:4px;">Aucune offre disponible pour le moment</div>
        <div style="color:var(--text-secondary);font-size:.84rem;">Aucune offre active ne correspond actuellement à votre type de contrat. Revenez bientôt !</div>
    </div>
{% else %}
    <div style="margin-bottom:24px;">
        {% for item in stats.offres_recommandees %}
            {% set offre = item.offre %}
            {% set score = item.score %}
            {% set matched = item.competences_matchees|default([]) %}
            {% set missing = item.competences_manquantes|default([]) %}
            <div class="offer-card">
                <div class="offer-logo">{{ offre.entreprise ? offre.entreprise.raisonSociale|first|upper : '?' }}</div>
                <div class="offer-info">
                    <div class="offer-title">{{ offre.titre }}</div>
                    <div class="offer-company">🏢 {{ offre.entreprise ? offre.entreprise.raisonSociale : 'Entreprise' }}</div>
                    <div class="offer-meta">
                        <span class="offer-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                            {{ offre.localisation }}
                        </span>
                        <span class="offer-meta-item">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            {{ offre.typeContratLabel }}{% if offre.dureeContrat %} · {{ offre.dureeContrat }}{% endif %}
                        </span>
                        {% if offre.salaire %}
                            <span class="offer-salary">{{ offre.salaire|number_format(0, ',', ' ') }} €</span>
                        {% endif %}
                    </div>
                    {% if offre.competencesRequisesArray|length > 0 %}
                        <div class="offer-tags">
                            {% for skill in offre.competencesRequisesArray|slice(0, 5) %}
                                <span class="tag">{{ skill }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                <div class="offer-actions">
                    <span class="score-tooltip-wrapper" tabindex="0">
                        {% if score is null %}
                            <span class="reco-score na">
                                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                Analyse en cours
                            </span>
                        {% elseif score >= 70 %}
                            <span class="reco-score high">
                                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                                {{ score }}% compatible
                            </span>
                        {% elseif score >= 40 %}
                            <span class="reco-score mid">
                                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                                {{ score }}% compatible
                            </span>
                        {% else %}
                            <span class="reco-score low">
                                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                                {{ score }}% compatible
                            </span>
                        {% endif %}

                        <div class="score-tooltip-content">
                            {% if score is null %}
                                <div class="score-tooltip-title">Analyse IA en cours</div>
                                <div class="score-tooltip-empty">Cette offre n'a pas encore été analysée par l'IA. Revenez un peu plus tard — le score apparaîtra automatiquement.</div>
                            {% else %}
                                <div class="score-tooltip-title">Score IA : {{ score }}% de compatibilité</div>
                                <div class="score-tooltip-section">
                                    <div class="score-tooltip-label matched">✓ Compétences correspondantes</div>
                                    {% if matched|length > 0 %}
                                        <div class="score-tooltip-chips">
                                            {% for c in matched %}<span class="score-tooltip-chip matched">{{ c }}</span>{% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="score-tooltip-empty">Aucune compétence commune identifiée.</div>
                                    {% endif %}
                                </div>
                                <div class="score-tooltip-section">
                                    <div class="score-tooltip-label missing">✗ Compétences manquantes</div>
                                    {% if missing|length > 0 %}
                                        <div class="score-tooltip-chips">
                                            {% for c in missing %}<span class="score-tooltip-chip missing">{{ c }}</span>{% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="score-tooltip-empty">Aucune compétence manquante détectée.</div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </span>
                    <div class="offer-date">Publiée le {{ offre.datePublication|date('d/m/Y') }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{# ── CANDIDATURES RÉCENTES ── #}
<div class="card">
    <div class="card-header">
        <div>
            <div class="card-title">Mes candidatures récentes</div>
            <div class="card-subtitle">Suivi de vos dernières postulations</div>
        </div>
    </div>
    {% if stats.candidatures_recentes|length > 0 %}
        <table class="data-table">
            <thead>
                <tr><th>Offre</th><th>Date</th><th>Score IA</th><th>Statut</th></tr>
            </thead>
            <tbody>
                {% for candidature in stats.candidatures_recentes %}
                <tr>
                    <td style="font-weight:600;">{{ candidature.offre ? candidature.offre.titre : '—' }}</td>
                    <td style="color:var(--text-secondary);">{{ candidature.dateCandidature ? candidature.dateCandidature|date('d/m/Y') : '—' }}</td>
                    <td>
                        {% if candidature.scoreMatching is not null %}
                            <span class="score-tooltip-wrapper" tabindex="0">
                                <span class="match-score {{ candidature.scoreMatching >= 80 ? 'high' : (candidature.scoreMatching >= 60 ? 'mid' : 'low') }}">{{ candidature.scoreMatching|round }}%</span>
                                <div class="score-tooltip-content">
                                    <div class="score-tooltip-title">Score IA : {{ candidature.scoreMatching|round }}% de compatibilité</div>
                                    <div class="score-tooltip-section">
                                        <div class="score-tooltip-label matched">✓ Compétences correspondantes</div>
                                        {% if candidature.competencesMatcheesArray|length > 0 %}
                                            <div class="score-tooltip-chips">
                                                {% for c in candidature.competencesMatcheesArray %}<span class="score-tooltip-chip matched">{{ c }}</span>{% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="score-tooltip-empty">Aucune compétence commune identifiée.</div>
                                        {% endif %}
                                    </div>
                                    <div class="score-tooltip-section">
                                        <div class="score-tooltip-label missing">✗ Compétences manquantes</div>
                                        {% if candidature.competencesManquantesArray|length > 0 %}
                                            <div class="score-tooltip-chips">
                                                {% for c in candidature.competencesManquantesArray %}<span class="score-tooltip-chip missing">{{ c }}</span>{% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="score-tooltip-empty">Aucune compétence manquante détectée.</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {% if candidature.statut == 'accepte' %}
                            <span class="badge badge-success">{{ candidature.statutLabel }}</span>
                        {% elseif candidature.statut == 'refuse' %}
                            <span class="badge badge-danger">{{ candidature.statutLabel }}</span>
                        {% else %}
                            <span class="badge badge-warning">{{ candidature.statutLabel }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div style="padding:32px 20px;text-align:center;color:var(--text-muted);font-size:.85rem;">Vous n'avez pas encore postulé à une offre.</div>
    {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const PALETTE = ['#6366f1', '#22c55e', '#f59e0b', '#3b82f6', '#ec4899', '#a855f7'];

    const typeContratData        = {{ stats.offres_par_type_contrat|json_encode|raw }};
    const modeTravailData        = {{ stats.offres_par_mode_travail|json_encode|raw }};
    const candidaturesStatutData = {{ stats.candidatures_par_statut|json_encode|raw }};

    const TYPE_CONTRAT_LABELS = { stage: 'Stage', emploi: 'Emploi' };
    const MODE_TRAVAIL_LABELS = { sur_site: 'Sur site', teletravail: 'Télétravail', hybride: 'Hybride' };
    const STATUT_LABELS       = { en_attente: 'En attente', accepte: 'Accepté', refuse: 'Refusé' };

    function renderPie(canvasId, dataObj, labelsMap) {
        const el = document.getElementById(canvasId);
        if (!el) return;
        const keys = Object.keys(dataObj);
        new Chart(el, {
            type: 'doughnut',
            data: {
                labels: keys.map(k => labelsMap[k] || k),
                datasets: [{ data: keys.map(k => dataObj[k]), backgroundColor: PALETTE, borderWidth: 0 }],
            },
            options: {
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } } },
                cutout: '60%',
            },
        });
    }

    renderPie('chart-type-contrat', typeContratData, TYPE_CONTRAT_LABELS);
    renderPie('chart-mode-travail', modeTravailData, MODE_TRAVAIL_LABELS);
    renderPie('chart-candidatures-statut', candidaturesStatutData, STATUT_LABELS);
})();
</script>

{% endblock %}