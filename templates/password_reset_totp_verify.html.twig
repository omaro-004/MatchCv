{% extends 'base.html.twig' %}

{% block title %}Vérification par application d'authentification{% endblock %}

{% block auth_body %}
<div class="auth-wrapper">
    <div class="auth-card">

        <div style="margin-bottom:24px;">
            <div style="width:48px;height:48px;background:rgba(99,102,241,.1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
                <svg width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <div style="font-size:1.1rem;font-weight:800;color:var(--text-primary);margin-bottom:4px;">Code d'authentification</div>
            <div style="font-size:.84rem;color:var(--text-secondary);line-height:1.5;">
                Ouvrez votre application d'authentification et saisissez le code à 6 chiffres généré pour MatchCV.
            </div>
        </div>

        <form method="post" action="{{ path('app_password_reset_totp_verify') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_totp') }}">

            <div class="form-group">
                <label for="code">Code à 6 chiffres</label>
                <input class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6"
                       id="code" name="code" placeholder="000000"
                       style="text-align:center;letter-spacing:6px;font-size:1.3rem;font-weight:700;" required autofocus>
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:8px;">
                Vérifier le code
            </button>
        </form>

        <div style="text-align:center;margin-top:16px;">
            <a href="{{ path('app_password_reset_method') }}" style="font-size:.82rem;color:var(--text-muted);">Retour</a>
        </div>

    </div>
</div>
{% endblock %}