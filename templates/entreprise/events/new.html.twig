{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}
{% block page_title %}Nouvel événement{% endblock %}
{% block page_subtitle %}Renseignez les détails ci-dessous pour publier votre événement{% endblock %}

{% block stylesheets %}
{{ include('entreprise/events/_form_styles.html.twig') }}
{% endblock %}

{% block body %}
{% macro field_error(field) %}
    {% if field.vars.errors|length %}
        <div class="form-error">{{ form_errors(field) }}</div>
    {% endif %}
{% endmacro %}

<div style="margin-bottom:16px;">
    <a href="{{ path('app_entreprise_events') }}" style="color:var(--text-muted);display:inline-flex;align-items:center;gap:5px;font-size:.82rem;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5m7-7l-7 7 7 7"/></svg>
        Retour aux événements
    </a>
</div>

<div class="evt-form-layout">

    <div class="card evt-form-card">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'evenement-form'}}) }}

            <div class="form-group">
                <label>{{ form_label(form.titre) }}</label>
                {{ form_widget(form.titre) }}
                {{ _self.field_error(form.titre) }}
            </div>

            <div class="form-group">
                <label>{{ form_label(form.description) }}</label>
                {{ form_widget(form.description) }}
                {{ _self.field_error(form.description) }}
            </div>

            <div class="form-group">
                <label>{{ form_label(form.photo) }}</label>
                {{ form_widget(form.photo) }}
                {{ _self.field_error(form.photo) }}
            </div>

            <div class="evt-online-toggle">
                <div>
                    <div style="font-weight:700;font-size:.92rem;color:var(--text-primary);margin-bottom:2px;">Format de l'événement</div>
                    <div class="form-hint" id="evt-online-desc" style="margin-top:0;">Présentiel — un lieu est requis</div>
                </div>
                <label class="evt-switch">
                    {{ form_widget(form.isOnline, {'attr': {'id': 'evenement_isOnline_input'}}) }}
                    <span class="evt-switch-slider" id="evt-switch-slider">
                        <span class="evt-switch-knob"></span>
                    </span>
                </label>
            </div>

            <div class="form-group" id="evt-lieu-group">
                <label>{{ form_label(form.lieu) }}</label>
                {{ form_widget(form.lieu) }}
                {{ _self.field_error(form.lieu) }}
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>{{ form_label(form.debutAt) }}</label>
                    {{ form_widget(form.debutAt) }}
                    {{ _self.field_error(form.debutAt) }}
                </div>
                <div class="form-group">
                    <label>{{ form_label(form.finAt) }}</label>
                    {{ form_widget(form.finAt) }}
                    {{ _self.field_error(form.finAt) }}
                </div>
            </div>

            <div class="form-group">
                <label>{{ form_label(form.capacite) }}</label>
                {{ form_widget(form.capacite) }}
                {{ _self.field_error(form.capacite) }}
            </div>

            <div style="display:flex;gap:10px;margin-top:8px;">
                <a href="{{ path('app_entreprise_events') }}" class="btn btn-secondary" style="flex:1;justify-content:center;">Annuler</a>
                <button type="submit" class="btn btn-primary" style="flex:2;justify-content:center;">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Publier l'événement
                </button>
            </div>

        {{ form_end(form) }}
    </div>

    {# ── Aperçu live ── #}
    <div class="evt-preview-card">
        <div class="evt-preview-label">Aperçu</div>
        <div class="evt-preview-badge" id="evt-preview-format">📍 Présentiel</div>
        <div style="height:140px;overflow:hidden;border-radius:8px;margin-bottom:8px;display:flex;align-items:center;justify-content:center;background:#f6f6f6;">
            <img id="evt-preview-photo" src="" alt="Aperçu photo" style="max-width:100%;max-height:140px;object-fit:cover;display:none;" />
        </div>
        <div class="evt-preview-title" id="evt-preview-title">Titre de votre événement</div>
        <div class="evt-preview-meta" id="evt-preview-meta">Renseignez les dates pour voir l'aperçu</div>
        <div class="evt-preview-desc" id="evt-preview-desc">La description apparaîtra ici au fur et à mesure de votre saisie.</div>
    </div>

</div>

<script>
(function () {
    const titleInput   = document.querySelector('#evenement_titre');
    const descInput    = document.querySelector('#evenement_description');
    const onlineInput  = document.querySelector('#evenement_isOnline_input') || document.querySelector('#evenement_isOnline');
    const lieuGroup    = document.getElementById('evt-lieu-group');
    const lieuInput    = document.querySelector('#evenement_lieu');
    const debutInput   = document.querySelector('#evenement_debutAt');
    const finInput     = document.querySelector('#evenement_finAt');
    const capaciteInput = document.querySelector('#evenement_capacite');
    const slider       = document.getElementById('evt-switch-slider');
    const onlineDesc   = document.getElementById('evt-online-desc');

    const previewTitle  = document.getElementById('evt-preview-title');
    const previewMeta   = document.getElementById('evt-preview-meta');
    const previewDesc   = document.getElementById('evt-preview-desc');
    const previewFormat = document.getElementById('evt-preview-format');

    function toggleOnlineUI() {
        const isOnline = onlineInput && onlineInput.checked;

        if (slider) slider.classList.toggle('checked', !!isOnline);
        if (lieuGroup) lieuGroup.style.display = isOnline ? 'none' : 'block';
        if (lieuInput) lieuInput.required = !isOnline;
        if (onlineDesc) {
            onlineDesc.textContent = isOnline
                ? 'En ligne — aucun lieu requis'
                : 'Présentiel — un lieu est requis';
        }
        if (previewFormat) {
            previewFormat.textContent = isOnline ? '💻 En ligne' : '📍 ' + (lieuInput && lieuInput.value ? lieuInput.value : 'Présentiel');
        }
    }

    function updatePreview() {
        if (previewTitle) previewTitle.textContent = (titleInput && titleInput.value) || 'Titre de votre événement';
        if (previewDesc) previewDesc.textContent = (descInput && descInput.value) || 'La description apparaîtra ici au fur et à mesure de votre saisie.';

        let meta = '';
        if (debutInput && debutInput.value) meta += 'Début : ' + debutInput.value.replace('T', ' à ');
        if (finInput && finInput.value) meta += (meta ? ' — Fin : ' : 'Fin : ') + finInput.value.replace('T', ' à ');
        if (capaciteInput && capaciteInput.value) meta += (meta ? ' · ' : '') + capaciteInput.value + ' places';
        if (previewMeta) previewMeta.textContent = meta || 'Renseignez les dates pour voir l\'aperçu';

        // Image preview
        const previewPhoto = document.getElementById('evt-preview-photo');
        const photoInput = document.querySelector('#evenement_photo');
        if (previewPhoto && photoInput && photoInput.files && photoInput.files[0]) {
            previewPhoto.src = URL.createObjectURL(photoInput.files[0]);
            previewPhoto.style.display = 'block';
        } else if (previewPhoto) {
            previewPhoto.style.display = 'none';
            previewPhoto.src = '';
        }

        toggleOnlineUI();
    }

    [titleInput, descInput, lieuInput, debutInput, finInput, capaciteInput].forEach(function (el) {
        if (el) el.addEventListener('input', updatePreview);
    });
    if (onlineInput) onlineInput.addEventListener('change', updatePreview);

    updatePreview();
})();
</script>

{% endblock %}
