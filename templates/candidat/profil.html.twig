{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block page_title %}Mon profil{% endblock %}
{% block page_subtitle %}Vos informations, enrichies automatiquement par l'analyse IA de votre CV{% endblock %}

{% block body %}

<style>
    .candidate-profile-hero {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 26px;
        margin-bottom: 20px;
        color: #fff;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(59,130,246,.92) 45%, rgba(249,115,22,.86));
        box-shadow: 0 24px 48px rgba(15,23,42,.16);
    }
    .candidate-profile-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(255,255,255,.14), transparent 28%), radial-gradient(circle at bottom left, rgba(255,255,255,.08), transparent 24%);
        pointer-events: none;
    }
    .candidate-profile-hero-inner {
        position: relative;
        z-index: 1;
        display:flex;
        justify-content:space-between;
        gap:18px;
        flex-wrap:wrap;
        align-items:end;
    }
    .candidate-profile-hero h2 { margin:8px 0 10px; font-size:clamp(1.6rem, 2.5vw, 2.8rem); line-height:1.04; letter-spacing:-.05em; }
    .candidate-profile-hero p { margin:0; max-width:62ch; color: rgba(255,255,255,.84); line-height:1.65; }
    .candidate-profile-pill {
        display:inline-flex;
        align-items:center;
        gap:8px;
        margin-top:14px;
        padding:8px 12px;
        border-radius:999px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        font-size:.82rem;
        font-weight:600;
    }
    .candidate-profile-grid { display:grid; grid-template-columns:280px 1fr; gap:20px; align-items:start; }
    .candidate-profile-side,
    .candidate-profile-main > .card {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        background: linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,247,237,.86));
        border: 1px solid rgba(148,163,184,.16);
        box-shadow: 0 16px 40px rgba(15,23,42,.08);
    }
    .candidate-profile-avatar {
        width: 96px;
        height: 96px;
        border-radius: 28px;
        background: linear-gradient(135deg,#fb7185,#f97316 45%,#3b82f6);
        display:flex;
        align-items:center;
        justify-content:center;
        color:#fff;
        font-size:2rem;
        font-weight:800;
        margin:0 auto 16px;
        overflow:hidden;
        box-shadow: 0 18px 32px rgba(249,115,22,.18);
    }
    .candidate-profile-avatar img { width:100%; height:100%; object-fit:cover; }
    .candidate-profile-main { display:flex; flex-direction:column; gap:16px; }
    @media (max-width: 960px) {
        .candidate-profile-grid { grid-template-columns: 1fr; }
    }
</style>

<section class="candidate-profile-hero">
    <div class="candidate-profile-hero-inner">
        <div>
            <div class="badge badge-neutral" style="background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.16);">Profil candidat</div>
            <h2>Votre parcours, vos atouts, votre identité professionnelle.</h2>
            <p>Ce profil rassemble vos informations, vos compétences et les données extraites du CV dans une présentation plus inspirée et plus lisible.</p>
            <div class="candidate-profile-pill">✨ Mise en valeur automatique par IA</div>
        </div>
        <div class="candidate-profile-pill" style="background:rgba(255,255,255,.16);">{{ profil.hasCv ? 'CV disponible' : 'CV à compléter' }}</div>
    </div>
</section>

<div class="candidate-profile-grid">

    {# ── COLONNE GAUCHE : identité ── #}
    <div class="candidate-profile-side" style="padding:24px;text-align:center;">
        <div class="candidate-profile-avatar">
            {% if profil.photo %}
                <img src="{{ asset(profil.photo) }}" alt="Photo de profil" style="width:100%;height:100%;object-fit:cover;">
            {% else %}
                {{ profil.nomComplet|first|upper }}
            {% endif %}
        </div>
        <div style="font-weight:800;font-size:1.05rem;color:var(--text-primary);">{{ profil.nomComplet }}</div>
        <div style="font-size:.82rem;color:var(--text-secondary);margin-top:2px;">{{ user.email }}</div>

        <div style="margin-top:16px;display:flex;flex-direction:column;gap:8px;text-align:left;font-size:.83rem;color:var(--text-secondary);">
            <div>📍 {{ profil.localisation ?: 'Non renseignée' }}</div>
            <div>📞 {{ profil.numTel ?: 'Non renseigné' }}</div>
            <div>💼 {{ profil.typeContratLabel }}</div>
            {% if profil.anneesExperience is not null %}
                <div>🧭 {{ profil.anneesExperience }} an{{ profil.anneesExperience > 1 ? 's' : '' }} d'expérience</div>
            {% endif %}
        </div>

        <a href="{{ path('app_profil_candidat_edit') }}" class="btn btn-primary btn-full" style="margin-top:18px;">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Modifier mon profil
        </a>

        {% if profil.hasCv %}
            <a href="{{ asset(profil.cv) }}" target="_blank" class="btn btn-secondary btn-full" style="margin-top:10px;">
                📄 Voir mon CV
            </a>
        {% endif %}

        {% if profil.hasAiParsedData %}
            <div style="margin-top:14px;font-size:.72rem;color:var(--text-muted);">
                Profil enrichi par IA le {{ profil.cvAiParsedAt|date('d/m/Y à H:i') }}
            </div>
        {% else %}
            <div style="margin-top:14px;font-size:.72rem;color:var(--text-muted);">
                L'analyse IA de votre CV n'a pas encore produit de données exploitables.
            </div>
        {% endif %}
    </div>

    {# ── COLONNE DROITE : contenu enrichi ── #}
    <div class="candidate-profile-main">

        {% if profil.resumeIa %}
        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:8px;">✨ Résumé généré par IA</div>
            <p style="font-size:.88rem;color:var(--text-secondary);line-height:1.6;">{{ profil.resumeIa }}</p>
        </div>
        {% endif %}

        {% if profil.bio %}
        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:8px;">À propos</div>
            <p style="font-size:.88rem;color:var(--text-secondary);line-height:1.6;">{{ profil.bio }}</p>
        </div>
        {% endif %}

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">🛠️ Compétences techniques</div>
            {% if profil.competencesTechniquesArray|length > 0 %}
                <div class="offer-tags">
                    {% for competence in profil.competencesTechniquesArray %}
                        <span class="tag">{{ competence }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucune compétence détectée automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">🌐 Langues parlées</div>
            {% if profil.languesParleesArray|length > 0 %}
                <div class="offer-tags">
                    {% for langue in profil.languesParleesArray %}
                        <span class="tag">{{ langue }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucune langue détectée automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">🎓 Formations</div>
            {% if profil.formationsArray|length > 0 %}
                <ul style="padding-left:18px;font-size:.85rem;color:var(--text-secondary);line-height:1.8;">
                    {% for formation in profil.formationsArray %}
                        <li>{{ formation }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucune formation détectée automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">💼 Expériences professionnelles</div>
            {% if profil.experiencesProfessionnellesArray|length > 0 %}
                <ul style="padding-left:18px;font-size:.85rem;color:var(--text-secondary);line-height:1.8;">
                    {% for experience in profil.experiencesProfessionnellesArray %}
                        <li>{{ experience }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucune expérience professionnelle détectée automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">🚀 Projets académiques</div>
            {% if profil.projetsAcademiquesArray|length > 0 %}
                <ul style="padding-left:18px;font-size:.85rem;color:var(--text-secondary);line-height:1.8;">
                    {% for projet in profil.projetsAcademiquesArray %}
                        <li>{{ projet }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucun projet académique détecté automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

        <div class="card" style="padding:20px;">
            <div class="card-title" style="margin-bottom:12px;">🤝 Soft skills</div>
            {% if profil.softSkillsArray|length > 0 %}
                <div class="offer-tags">
                    {% for skill in profil.softSkillsArray %}
                        <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <p style="font-size:.82rem;color:var(--text-muted);">Aucun soft skill détecté automatiquement dans le CV pour le moment.</p>
            {% endif %}
        </div>

    </div>
</div>

{% endblock %}