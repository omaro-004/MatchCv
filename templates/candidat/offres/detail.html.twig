{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }}{% endblock %}
{% block page_title %}{{ offre.titre }}{% endblock %}
{% block page_subtitle %}{{ entreprise.raisonSociale }} · {{ offre.localisation }}{% endblock %}

{% block body %}

<style>
    .candidate-detail-hero {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 24px;
        margin-bottom: 18px;
        color: #fff;
        background: linear-gradient(135deg, rgba(15,23,42,.96) 0%, rgba(30,41,59,.95) 38%, rgba(249,115,22,.9) 100%);
        box-shadow: 0 24px 48px rgba(15,23,42,.16);
    }
    .candidate-detail-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(255,255,255,.12), transparent 30%), radial-gradient(circle at bottom left, rgba(59,130,246,.16), transparent 24%);
        pointer-events: none;
    }
    .candidate-detail-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0,1.25fr) minmax(260px,.75fr);
        gap: 18px;
        align-items: start;
    }
    .candidate-detail-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        font-size: .8rem;
        font-weight: 600;
    }
    .candidate-detail-title {
        margin: 12px 0 10px;
        font-size: clamp(1.8rem, 3vw, 3rem);
        line-height: 1.04;
        letter-spacing: -.05em;
    }
    .candidate-detail-meta { display:flex; flex-wrap:wrap; gap:10px; color: rgba(255,255,255,.84); }
    .candidate-detail-meta span {
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.12);
    }
    .candidate-detail-aside {
        border-radius: 24px;
        padding: 18px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.16);
        backdrop-filter: blur(16px);
    }
    .candidate-detail-aside strong { display:block; font-size:1.1rem; margin-bottom:8px; }
    .candidate-detail-aside p { margin:0; color: rgba(255,255,255,.84); line-height:1.6; }
    .candidate-detail-panels {
        display:grid;
        grid-template-columns: minmax(0,1fr) 340px;
        gap: 20px;
        align-items:start;
    }
    @media (max-width: 980px) {
        .candidate-detail-grid,
        .candidate-detail-panels { grid-template-columns: 1fr; }
    }
</style>

<div style="margin-bottom:16px;">
    <a href="{{ path('app_candidat_offres_liste') }}" style="color:var(--text-muted);display:inline-flex;align-items:center;gap:5px;font-size:.82rem;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5m7-7l-7 7 7 7"/></svg>
        Retour aux offres
    </a>
</div>

<section class="candidate-detail-hero">
    <div class="candidate-detail-grid">
        <div>
            <div class="candidate-detail-eyebrow">{{ offre.typeContratLabel }} · {{ offre.modeTravailLabel }}</div>
            <div class="candidate-detail-title">{{ offre.titre }}</div>
            <div class="candidate-detail-meta">
                <span>🏢 {{ entreprise.raisonSociale }}</span>
                <span>📍 {{ offre.localisation }}</span>
                {% if offre.salaire %}<span>💸 {{ offre.salaire|number_format(0, ',', ' ') }} €</span>{% endif %}
                {% if offre.dateDebut %}<span>📅 Début {{ offre.dateDebut|date('d/m/Y') }}</span>{% endif %}
            </div>
        </div>
        <div class="candidate-detail-aside">
            <strong>Décision rapide</strong>
            <p>Comparez les compétences, regardez la culture de l’entreprise et postulez directement depuis cette page.</p>
        </div>
    </div>
</section>

<div class="candidate-detail-panels">

    {# ── COLONNE PRINCIPALE ── #}
    <div style="display:flex;flex-direction:column;gap:16px;">

        {# En-tête offre #}
        <div class="card" style="padding:24px;">
            <div style="display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap;">
                <div class="offer-logo" style="width:60px;height:60px;font-size:1.3rem;background:linear-gradient(135deg,#6366f1,#a855f7);overflow:hidden;">
                    {% if entreprise.logo %}
                        <img src="{{ asset(entreprise.logo) }}" alt="{{ entreprise.raisonSociale }}" style="width:100%;height:100%;object-fit:cover;">
                    {% else %}
                        {{ entreprise.raisonSociale|first|upper }}
                    {% endif %}
                </div>
                <div style="flex:1;min-width:200px;">
                    <div style="font-size:1.3rem;font-weight:800;color:var(--text-primary);">{{ offre.titre }}</div>
                    <div style="color:var(--text-secondary);font-size:.9rem;margin-top:2px;">{{ entreprise.raisonSociale }}</div>
                    <div class="offer-meta" style="margin-top:10px;">
                        <span class="offer-meta-item">📍 {{ offre.localisation }}</span>
                        <span class="offer-meta-item">💼 {{ offre.typeContratLabel }}{% if offre.dureeContrat %} · {{ offre.dureeContrat }}{% endif %}</span>
                        <span class="offer-meta-item">🏠 {{ offre.modeTravailLabel }}</span>
                        {% if offre.dateDebut %}<span class="offer-meta-item">📅 Début : {{ offre.dateDebut|date('d/m/Y') }}</span>{% endif %}
                        {% if offre.salaire %}<span class="offer-salary">{{ offre.salaire|number_format(0, ',', ' ') }} €</span>{% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Description #}
        <div class="card" style="padding:24px;">
            <div class="card-title" style="margin-bottom:10px;">Description du poste</div>
            <p style="font-size:.9rem;color:var(--text-secondary);line-height:1.7;white-space:pre-line;">{{ offre.description }}</p>
        </div>

        {# Compétences requises #}
        {% if offre.competencesRequisesArray|length > 0 %}
        <div class="card" style="padding:24px;">
            <div class="card-title" style="margin-bottom:10px;">Compétences recherchées</div>
            <div class="offer-tags">
                {% for c in offre.competencesRequisesArray %}
                    <span class="tag">{{ c }}</span>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# À propos de l'entreprise + localisation carte #}
        <div class="card" style="padding:24px;">
            <div class="card-title" style="margin-bottom:12px;">À propos de {{ entreprise.raisonSociale }}</div>
            <div style="display:flex;flex-wrap:wrap;gap:16px;font-size:.85rem;color:var(--text-secondary);margin-bottom:16px;">
                {% if entreprise.secteur %}<div>🏭 {{ entreprise.secteur }}</div>{% endif %}
                {% if entreprise.type %}<div>🏢 {{ entreprise.type }}</div>{% endif %}
                {% if entreprise.lienSite %}<div>🌐 <a href="{{ entreprise.lienSite }}" target="_blank" style="color:var(--accent);">{{ entreprise.lienSite }}</a></div>{% endif %}
            </div>
            {% if entreprise.localisation %}
            <div style="border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border);">
                <iframe
                    src="https://www.google.com/maps?q={{ entreprise.localisation|url_encode }}&output=embed"
                    width="100%" height="260" style="border:0;display:block;" loading="lazy">
                </iframe>
            </div>
            {% endif %}
        </div>

        {# Avis candidats #}
        <div class="card" style="padding:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
                <div class="card-title">Avis des candidats</div>
                {% if note_moyenne is not null %}
                    <div style="font-weight:700;color:var(--warning);">★ {{ note_moyenne }}/5 <span style="color:var(--text-muted);font-weight:400;font-size:.8rem;">({{ nombre_avis }} avis)</span></div>
                {% else %}
                    <div style="color:var(--text-muted);font-size:.82rem;">Aucun avis pour le moment</div>
                {% endif %}
            </div>

            {% for a in avis %}
                <div style="padding:12px 0;border-bottom:1px solid var(--border);">
                    <div style="display:flex;justify-content:space-between;">
                        <strong style="font-size:.85rem;">{{ a.candidat.nomComplet|split(' ')|first }}</strong>
                        <span style="color:var(--warning);font-size:.82rem;">
                            {% for i in 1..5 %}{{ i <= a.note ? '★' : '☆' }}{% endfor %}
                        </span>
                    </div>
                    {% if a.commentaire %}<p style="font-size:.83rem;color:var(--text-secondary);margin-top:4px;">{{ a.commentaire }}</p>{% endif %}
                    <div style="font-size:.72rem;color:var(--text-muted);margin-top:2px;">{{ a.dateAvis|date('d/m/Y') }}</div>
                </div>
            {% else %}
                <p style="font-size:.83rem;color:var(--text-muted);">Soyez le premier à partager votre expérience avec cette entreprise.</p>
            {% endfor %}

            <form method="post" action="{{ path('app_candidat_entreprise_avis', {id: entreprise.id}) }}" style="margin-top:18px;padding-top:16px;border-top:1px solid var(--border);">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('laisser_avis') }}">
                <div class="form-group">
                    <label>{{ mon_avis ? 'Modifier mon avis' : 'Laisser un avis' }}</label>
                    <select name="note" class="form-control filter-select" style="width:auto;">
                        {% for n in [5,4,3,2,1] %}
                            <option value="{{ n }}" {{ mon_avis and mon_avis.note == n ? 'selected' : (not mon_avis and n == 5 ? 'selected' : '') }}>{{ n }} ★</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <textarea name="commentaire" class="form-control" rows="2" placeholder="Votre expérience avec cette entreprise (optionnel)">{{ mon_avis ? mon_avis.commentaire : '' }}</textarea>
                </div>
                <button type="submit" class="btn btn-secondary btn-sm">{{ mon_avis ? 'Mettre à jour mon avis' : 'Publier mon avis' }}</button>
            </form>
        </div>

    </div>

    {# ── COLONNE LATÉRALE : CTA postuler ── #}
    <div style="position:sticky;top:80px;">
        <div class="card" style="padding:22px;text-align:center;">
            {% if deja_candidate %}
                <div class="badge badge-success" style="margin-bottom:12px;">✓ Candidature envoyée</div>
                <p style="font-size:.82rem;color:var(--text-secondary);margin-bottom:14px;">Vous avez déjà postulé à cette offre.</p>
                <a href="{{ path('app_candidat_candidatures_liste') }}" class="btn btn-secondary btn-full">Voir mes candidatures</a>
            {% else %}
                <p style="font-size:.85rem;color:var(--text-secondary);margin-bottom:14px;">Ce poste vous intéresse ? Postulez en quelques secondes grâce à votre profil déjà rempli.</p>
                <a href="{{ path('app_candidat_offre_postuler', {id: offre.id}) }}" class="btn btn-primary btn-full btn-lg" id="btn-postuler" style="animation:pulse-cta 1.8s infinite;">
                    🚀 Postuler à cette offre
                </a>
            {% endif %}
        </div>
    </div>

</div>

<style>
@keyframes pulse-cta {
    0%, 100% { box-shadow: 0 4px 14px rgba(99,102,241,.35); }
    50% { box-shadow: 0 4px 22px rgba(99,102,241,.65); }
}
</style>

{% endblock %}