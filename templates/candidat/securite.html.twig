{% extends 'base.html.twig' %}

{% block title %}Sécurité{% endblock %}
{% block page_title %}Sécurité{% endblock %}
{% block page_subtitle %}Gérez la protection de votre compte{% endblock %}

{% block body %}
<div class="card" style="max-width:640px;">
    <div class="card-header">
        <div>
            <div class="card-title">Application d'authentification</div>
            <div class="card-subtitle">Récupérez votre compte via un code à 6 chiffres, sans passer par l'email</div>
        </div>
    </div>
    <div class="card-body">

        <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border:1.5px solid var(--border);border-radius:var(--radius-md);margin-bottom:20px;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;border-radius:10px;background:{{ totp_enabled ? 'rgba(34,197,94,.1)' : 'rgba(148,163,184,.15)' }};display:flex;align-items:center;justify-content:center;">
                    <svg width="18" height="18" fill="none" stroke="{{ totp_enabled ? 'var(--success)' : 'var(--text-muted)' }}" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                </div>
                <div>
                    <div style="font-weight:700;font-size:.9rem;" id="totp-status-label">
                        {{ totp_enabled ? 'Activée' : 'Désactivée' }}
                    </div>
                    <div style="font-size:.78rem;color:var(--text-muted);">Récupération de mot de passe via code à 6 chiffres</div>
                </div>
            </div>
            {% if totp_enabled %}
                <button id="btn-disable-totp" class="btn btn-secondary btn-sm">Désactiver</button>
            {% else %}
                <button id="btn-start-totp" class="btn btn-primary btn-sm">Activer</button>
            {% endif %}
        </div>

        <div id="totp-setup" style="display:none;">
            <div style="font-size:.84rem;color:var(--text-secondary);margin-bottom:14px;">
                Scannez ce QR code avec Google Authenticator, Microsoft Authenticator ou Authy, puis saisissez le code généré pour confirmer.
            </div>
            <div style="display:flex;justify-content:center;margin-bottom:16px;">
                <img id="totp-qr" src="" alt="QR Code" style="width:200px;height:200px;border:1px solid var(--border);border-radius:var(--radius-md);padding:8px;">
            </div>
            <div style="text-align:center;font-size:.76rem;color:var(--text-muted);margin-bottom:16px;">
                Impossible de scanner ? Saisissez ce code manuellement :<br>
                <code id="totp-secret" style="font-weight:700;letter-spacing:1px;"></code>
            </div>

            <div class="form-group">
                <label for="totp-code">Code de vérification</label>
                <input class="form-control" type="text" inputmode="numeric" maxlength="6" id="totp-code" placeholder="000000" style="text-align:center;letter-spacing:6px;font-size:1.2rem;font-weight:700;">
            </div>

            <div id="totp-feedback" style="display:none;margin-bottom:12px;padding:10px 14px;border-radius:var(--radius-sm);font-size:.82rem;font-weight:500;"></div>

            <div style="display:flex;gap:10px;">
                <button id="btn-confirm-totp" class="btn btn-primary" style="flex:1;">Confirmer et activer</button>
                <button id="btn-cancel-totp" class="btn btn-secondary">Annuler</button>
            </div>
        </div>

    </div>
</div>

<script>
const $ = id => document.getElementById(id);
const CSRF_GENERATE = '{{ csrf_token("totp_generate") }}';
const CSRF_CONFIRM  = '{{ csrf_token("totp_confirm") }}';
const CSRF_DISABLE  = '{{ csrf_token("totp_disable") }}';
const GENERATE_URL  = '{{ path("app_totp_generate") }}';
const CONFIRM_URL   = '{{ path("app_totp_confirm") }}';
const DISABLE_URL   = '{{ path("app_totp_disable") }}';

const btnStart   = $('btn-start-totp');
const btnDisable = $('btn-disable-totp');
const setupBox   = $('totp-setup');
const feedback   = $('totp-feedback');

function showFeedback(msg, type) {
    feedback.style.display = 'block';
    feedback.textContent = msg;
    feedback.style.background = type === 'success' ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)';
    feedback.style.color = type === 'success' ? '#15803d' : '#b91c1c';
}

async function readJsonResponse(res) {
    const contentType = res.headers.get('content-type') || '';

    if (!contentType.includes('application/json')) {
        const text = await res.text();
        throw new Error(text || 'Réponse inattendue du serveur.');
    }

    return res.json();
}

if (btnStart) {
    btnStart.addEventListener('click', async () => {
        try {
            const res = await fetch(GENERATE_URL, {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_GENERATE },
            });
            const data = await readJsonResponse(res);

            if (!res.ok) {
                throw new Error(data.error || 'Impossible de générer le QR code.');
            }

            if (data.qr) {
                $('totp-qr').src = data.qr;
                $('totp-secret').textContent = data.secret;
                setupBox.style.display = 'block';
                btnStart.style.display = 'none';
            }
        } catch (error) {
            showFeedback(error.message || 'Impossible de générer le QR code.', 'error');
        }
    });
}

if ($('btn-cancel-totp')) {
    $('btn-cancel-totp').addEventListener('click', () => {
        setupBox.style.display = 'none';
        if (btnStart) btnStart.style.display = 'inline-flex';
    });
}

if ($('btn-confirm-totp')) {
    $('btn-confirm-totp').addEventListener('click', async () => {
        const code = $('totp-code').value.trim();
        if (code.length !== 6) {
            showFeedback('Saisissez un code à 6 chiffres.', 'error');
            return;
        }
        try {
            const res = await fetch(CONFIRM_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_CONFIRM },
                body: JSON.stringify({ code }),
            });
            const data = await readJsonResponse(res);

            if (data.success) {
                showFeedback('Application d\'authentification activée !', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showFeedback(data.error || 'Code invalide.', 'error');
            }
        } catch (error) {
            showFeedback(error.message || 'Code invalide.', 'error');
        }
    });
}

if (btnDisable) {
    btnDisable.addEventListener('click', async () => {
        if (!confirm('Désactiver la récupération par application d\'authentification ?')) return;
        try {
            const res = await fetch(DISABLE_URL, {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_DISABLE },
            });
            const data = await readJsonResponse(res);

            if (!res.ok) {
                throw new Error(data.error || 'Impossible de désactiver TOTP.');
            }

            if (data.success) window.location.reload();
        } catch (error) {
            showFeedback(error.message || 'Impossible de désactiver TOTP.', 'error');
        }
    });
}
</script>
{% endblock %}