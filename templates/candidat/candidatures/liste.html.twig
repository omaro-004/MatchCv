{% extends 'base.html.twig' %}

{% block title %}Mes candidatures{% endblock %}
{% block page_title %}Mes candidatures{% endblock %}
{% block page_subtitle %}{{ candidatures|length }} candidature{{ candidatures|length > 1 ? 's' : '' }} envoyée{{ candidatures|length > 1 ? 's' : '' }}{% endblock %}

{% block body %}

{% if candidatures|length == 0 %}
    <div class="card" style="padding:48px 24px;text-align:center;">
        <div style="font-size:2rem;margin-bottom:12px;">📭</div>
        <div style="font-weight:700;font-size:1rem;margin-bottom:6px;">Aucune candidature pour le moment</div>
        <div style="color:var(--text-secondary);font-size:.85rem;margin-bottom:20px;">Parcourez les offres disponibles et postulez en un clic.</div>
        <a href="{{ path('app_candidat_offres_liste') }}" class="btn btn-primary btn-sm" style="display:inline-flex;">Voir les offres</a>
    </div>
{% else %}
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Offre</th>
                    <th>Entreprise</th>
                    <th>Score IA</th>
                    <th>Statut</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                {% for c in candidatures %}
                <tr>
                    <td>
                        <a href="{{ path('app_candidat_offre_detail', {id: c.offre.id}) }}" style="font-weight:600;color:var(--text-primary);">{{ c.offre.titre }}</a>
                        <div style="font-size:.74rem;color:var(--text-muted);margin-top:2px;">{{ c.offre.localisation }} · {{ c.offre.typeContratLabel }}</div>
                    </td>
                    <td style="color:var(--text-secondary);font-size:.85rem;">{{ c.offre.entreprise.raisonSociale }}</td>
                    <td>
                        {% if c.scoreMatching is not null %}
                            <span class="score-tooltip-wrapper" tabindex="0">
                                <span class="match-score {{ c.scoreMatching >= 80 ? 'high' : (c.scoreMatching >= 60 ? 'mid' : 'low') }}">{{ c.scoreMatching|round }}%</span>
                                <div class="score-tooltip-content">
                                    <div class="score-tooltip-title">Score IA : {{ c.scoreMatching|round }}% de compatibilité</div>
                                    <div class="score-tooltip-section">
                                        <div class="score-tooltip-label matched">✓ Compétences correspondantes</div>
                                        {% if c.competencesMatcheesArray|length > 0 %}
                                            <div class="score-tooltip-chips">
                                                {% for skill in c.competencesMatcheesArray %}<span class="score-tooltip-chip matched">{{ skill }}</span>{% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="score-tooltip-empty">Aucune compétence commune identifiée.</div>
                                        {% endif %}
                                    </div>
                                    <div class="score-tooltip-section">
                                        <div class="score-tooltip-label missing">✗ Compétences manquantes</div>
                                        {% if c.competencesManquantesArray|length > 0 %}
                                            <div class="score-tooltip-chips">
                                                {% for skill in c.competencesManquantesArray %}<span class="score-tooltip-chip missing">{{ skill }}</span>{% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="score-tooltip-empty">Aucune compétence manquante détectée.</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </span>
                        {% else %}
                            <span style="color:var(--text-muted);font-size:.8rem;">En cours d'analyse</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {{ c.statut == 'accepte' ? 'badge-success' : (c.statut == 'refuse' ? 'badge-danger' : 'badge-warning') }}">{{ c.statutLabel }}</span>
                    </td>
                    <td style="color:var(--text-secondary);font-size:.85rem;">{{ c.dateCandidature|date('d/m/Y') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

{% endblock %}