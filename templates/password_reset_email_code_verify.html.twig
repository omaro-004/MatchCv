{% extends 'base.html.twig' %}

{% block title %}Vérification du code{% endblock %}

{% block auth_body %}
<div class="auth-wrapper">
    <div class="auth-card">

        <div style="margin-bottom:24px;">
            <div style="width:48px;height:48px;background:rgba(99,102,241,.1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
                <svg width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </div>
            <div style="font-size:1.1rem;font-weight:800;color:var(--text-primary);margin-bottom:4px;">Code de vérification</div>
            <div style="font-size:.84rem;color:var(--text-secondary);line-height:1.5;">
                Saisissez le code à 6 chiffres reçu par email (valable 15 minutes).
            </div>
        </div>

        <form method="post" action="{{ path('app_password_reset_email_code_verify') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_email_code_verify') }}">

            <div class="form-group">
                <label for="code">Code à 6 chiffres</label>
                <input class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6"
                       id="code" name="code" placeholder="000000"
                       style="text-align:center;letter-spacing:6px;font-size:1.3rem;font-weight:700;" required autofocus>
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:8px;">
                Vérifier le code
            </button>
        </form>

        <div style="text-align:center;margin-top:16px;display:flex;flex-direction:column;gap:6px;">
            <a href="{{ path('app_password_reset_email_code_request') }}" style="font-size:.82rem;color:var(--accent);font-weight:600;">Je n'ai pas reçu le code — renvoyer</a>
            <a href="{{ path('app_password_reset_method') }}" style="font-size:.82rem;color:var(--text-muted);">Retour</a>
        </div>

    </div>
</div>
{% endblock %}