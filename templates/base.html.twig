<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MatchCV{% endblock %} — Smart Career Matching</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── DESIGN TOKENS ── */
        :root {
            --sidebar-bg:   #12141f;
            --sidebar-w:    220px;
            --accent:       #6366f1;
            --accent-light: #818cf8;
            --accent-glow:  rgba(99,102,241,.18);
            --success:      #22c55e;
            --warning:      #f59e0b;
            --danger:       #ef4444;
            --surface:      #ffffff;
            --surface-2:    #f8f9fc;
            --border:       #e8eaf0;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --text-muted:   #94a3b8;
            --radius-sm:    8px;
            --radius-md:    12px;
            --radius-lg:    16px;
            --shadow-sm:    0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
            --shadow-md:    0 4px 16px rgba(0,0,0,.08);
            --shadow-lg:    0 8px 32px rgba(0,0,0,.12);
        }

        body.admin-shell {
            --sidebar-bg: linear-gradient(180deg, #020617 0%, #0b1120 45%, #111827 100%);
            --accent: #22d3ee;
            --accent-light: #67e8f9;
            --accent-glow: rgba(34,211,238,.18);
            --success: #34d399;
            --warning: #fbbf24;
            --danger: #fb7185;
            --surface: rgba(10,15,28,.78);
            --surface-2: rgba(15,23,42,.58);
            --border: rgba(148,163,184,.16);
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            background:
                radial-gradient(circle at top left, rgba(34,211,238,.14), transparent 34%),
                radial-gradient(circle at top right, rgba(167,139,250,.16), transparent 26%),
                radial-gradient(circle at 50% 18%, rgba(59,130,246,.12), transparent 28%),
                linear-gradient(135deg, #020617 0%, #0f172a 40%, #111827 100%);
            color: var(--text-primary);
            position: relative;
            overflow-x: hidden;
        }

        body.candidate-shell {
            --sidebar-bg: linear-gradient(180deg, #fff7ed 0%, #fff1f2 50%, #eef2ff 100%);
            --accent: #f97316;
            --accent-light: #fb7185;
            --accent-glow: rgba(249,115,22,.14);
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --surface: rgba(255,255,255,.84);
            --surface-2: rgba(255,247,237,.86);
            --border: rgba(148,163,184,.18);
            --text-primary: #111827;
            --text-secondary: #475569;
            --text-muted: #94a3b8;
            background:
                radial-gradient(circle at top left, rgba(251,146,60,.20), transparent 28%),
                radial-gradient(circle at top right, rgba(236,72,153,.12), transparent 24%),
                radial-gradient(circle at 70% 20%, rgba(59,130,246,.12), transparent 28%),
                linear-gradient(135deg, #fff7ed 0%, #fff 44%, #eff6ff 100%);
            color: var(--text-primary);
            position: relative;
            overflow-x: hidden;
        }

        body.candidate-shell::before,
        body.candidate-shell::after {
            content: '';
            position: fixed;
            pointer-events: none;
            z-index: 0;
            filter: blur(18px);
            opacity: .9;
        }

        body.candidate-shell::before {
            top: -120px;
            right: -90px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(249,115,22,.22) 0%, rgba(249,115,22,0) 70%);
            animation: candFloatA 15s ease-in-out infinite;
        }

        body.candidate-shell::after {
            bottom: -150px;
            left: -110px;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59,130,246,.18) 0%, rgba(59,130,246,0) 70%);
            animation: candFloatB 19s ease-in-out infinite;
        }

        @keyframes candFloatA {
            0%,100% { transform: translate3d(0,0,0) scale(1); }
            50% { transform: translate3d(-20px, 12px, 0) scale(1.08); }
        }

        @keyframes candFloatB {
            0%,100% { transform: translate3d(0,0,0) scale(1); }
            50% { transform: translate3d(16px, -18px, 0) scale(1.05); }
        }

        body.admin-shell::before,
        body.admin-shell::after {
            content: '';
            position: fixed;
            pointer-events: none;
            z-index: 0;
            filter: blur(20px);
            opacity: .75;
        }

        body.admin-shell::before {
            top: -140px;
            right: -120px;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(34,211,238,.22) 0%, rgba(34,211,238,0) 70%);
            animation: adminFloatA 16s ease-in-out infinite;
        }

        body.admin-shell::after {
            bottom: -160px;
            left: -120px;
            width: 380px;
            height: 380px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(251,191,36,.18) 0%, rgba(251,191,36,0) 70%);
            animation: adminFloatB 18s ease-in-out infinite;
        }

        @keyframes adminFloatA {
            0%,100% { transform: translate3d(0,0,0) scale(1); }
            50% { transform: translate3d(-18px, 16px, 0) scale(1.08); }
        }

        @keyframes adminFloatB {
            0%,100% { transform: translate3d(0,0,0) scale(1); }
            50% { transform: translate3d(18px, -14px, 0) scale(1.06); }
        }

        /* ── RESET ── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { font-size: 15px; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--surface-2);
            color: var(--text-primary);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }
        a { text-decoration: none; color: inherit; }
        button { cursor: pointer; border: none; background: none; font-family: inherit; }
        ul { list-style: none; }
        input, textarea, select { font-family: inherit; }

        /* ── AUTH LAYOUT (login / inscription) ── */
        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f0f1ff 0%, #fafafa 60%, #eff6ff 100%);
            padding: 24px;
        }
        .auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            padding: 40px 36px;
        }
        .auth-logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 32px;
        }
        .auth-logo-icon {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
            position: relative;
            box-shadow: 0 8px 24px rgba(99,102,241,.35);
        }
        .auth-logo-icon svg { color: #fff; }
        .auth-logo-badge {
            position: absolute;
            bottom: -4px;
            right: -4px;
            width: 20px;
            height: 20px;
            background: var(--success);
            border-radius: 50%;
            border: 2px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-logo h1 {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -.5px;
        }
        .auth-logo h1 span { color: var(--accent); }
        .auth-logo p {
            font-size: .85rem;
            color: var(--text-secondary);
            margin-top: 2px;
            text-align: center;
        }
        .auth-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 20px;
            text-align: center;
            color: var(--text-primary);
        }

        /* ── FORM ELEMENTS ── */
        .form-group { margin-bottom: 16px; }
        .form-group label {
            display: block;
            font-size: .82rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
        }
        .form-control {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: .9rem;
            color: var(--text-primary);
            background: var(--surface);
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }
        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }
        .form-control::placeholder { color: var(--text-muted); }
        .input-icon-wrap { position: relative; }
        .input-icon-wrap .form-control { padding-left: 40px; }
        .input-icon-wrap .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            width: 16px;
            height: 16px;
        }
        .input-icon-wrap .input-icon-right {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }
        .form-hint {
            font-size: .78rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        .form-error {
            font-size: .78rem;
            color: var(--danger);
            margin-top: 4px;
        }
        .form-error ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .form-error li {
            color: var(--danger);
            font-size: .78rem;
            margin-top: 4px;
            line-height: 1.45;
        }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }

        /* ── BUTTONS ── */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 20px;
            border-radius: var(--radius-sm);
            font-size: .88rem;
            font-weight: 600;
            transition: all .18s ease;
            line-height: 1;
        }
        .btn-primary {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            color: #fff;
            box-shadow: 0 4px 14px rgba(99,102,241,.35);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            box-shadow: 0 6px 20px rgba(99,102,241,.45);
            transform: translateY(-1px);
        }
        .btn-secondary {
            background: var(--surface);
            color: var(--text-primary);
            border: 1.5px solid var(--border);
        }
        .btn-secondary:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-glow);
        }
        .btn-outline-accent {
            background: transparent;
            color: var(--accent);
            border: 1.5px solid var(--accent);
        }
        .btn-outline-accent:hover {
            background: var(--accent);
            color: #fff;
        }
        .btn-danger {
            background: var(--danger);
            color: #fff;
        }
        .btn-danger:hover { background: #dc2626; }
        .btn-sm { padding: 7px 14px; font-size: .8rem; }
        .btn-lg { padding: 14px 28px; font-size: .95rem; }
        .btn-full { width: 100%; }
        .btn-icon { padding: 8px; border-radius: var(--radius-sm); }

        /* ── DIVIDER ── */
        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-muted);
            font-size: .8rem;
            margin: 20px 0;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ── SIDEBAR LAYOUT ── */
        .app-layout {
            display: flex;
            min-height: 100vh;
        }
        .sidebar {
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0;
            height: 100vh;
            z-index: 100;
            overflow-y: auto;
        }
        body.admin-shell .sidebar {
            border-right: 1px solid rgba(255,255,255,.08);
            box-shadow: 12px 0 40px rgba(2,6,23,.25);
            backdrop-filter: blur(18px);
        }
        .sidebar-logo {
            padding: 22px 20px 18px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }
        .sidebar-logo a {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #22d3ee, #8b5cf6 55%, #fb7185);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 12px 30px rgba(34,211,238,.22);
        }
        .sidebar-logo-text strong {
            display: block;
            font-size: .95rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.3px;
        }
        .sidebar-logo-text strong span { color: var(--accent-light); }
        .sidebar-logo-text small {
            font-size: .68rem;
            color: #64748b;
            font-weight: 500;
            letter-spacing: .3px;
            text-transform: uppercase;
        }
        .sidebar-section-label {
            padding: 16px 20px 6px;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #475569;
        }
        .sidebar-nav { padding: 8px 12px; flex: 1; }
        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            font-size: .86rem;
            font-weight: 500;
            color: #94a3b8;
            transition: all .15s;
            margin-bottom: 2px;
            position: relative;
        }
        .sidebar-nav-item:hover {
            background: rgba(255,255,255,.07);
            color: #e2e8f0;
            transform: translateX(3px);
        }
        .sidebar-nav-item.active {
            background: linear-gradient(135deg, rgba(34,211,238,.15), rgba(139,92,246,.14));
            color: var(--accent-light);
            font-weight: 600;
            box-shadow: inset 0 0 0 1px rgba(34,211,238,.18);
        }
        .sidebar-nav-item svg { width: 17px; height: 17px; flex-shrink: 0; }
        .sidebar-badge {
            margin-left: auto;
            background: var(--accent);
            color: #fff;
            font-size: .7rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 999px;
            line-height: 1.4;
        }
        .sidebar-footer {
            padding: 14px 16px;
            border-top: 1px solid rgba(255,255,255,.06);
        }
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background .15s;
        }
        .sidebar-user:hover { background: rgba(255,255,255,.06); }
        .sidebar-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }
        .sidebar-user-info { min-width: 0; }
        .sidebar-user-info strong {
            display: block;
            font-size: .82rem;
            font-weight: 600;
            color: #e2e8f0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .sidebar-user-info small {
            font-size: .72rem;
            color: #64748b;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-w);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 1;
        }
        .topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }
        body.admin-shell .topbar {
            background: rgba(2,6,23,.42);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255,255,255,.09);
            box-shadow: 0 8px 26px rgba(2,6,23,.18);
        }
        .topbar-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .topbar-subtitle {
            font-size: .8rem;
            color: var(--text-secondary);
            margin-top: 1px;
        }
        .topbar-actions { display: flex; align-items: center; gap: 10px; }
        .topbar-notif {
            position: relative;
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
            background: var(--surface-2);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            transition: all .15s;
            cursor: pointer;
        }
        .topbar-notif:hover { border-color: var(--accent); color: var(--accent); }
        .topbar-notif-dot {
            position: absolute;
            top: 6px;
            right: 7px;
            width: 7px;
            height: 7px;
            background: var(--danger);
            border-radius: 50%;
            border: 1.5px solid var(--surface);
        }
        .topbar-user {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 10px 5px 5px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--surface-2);
            cursor: pointer;
            transition: border-color .15s;
        }
        .topbar-user:hover { border-color: var(--accent); }
        .topbar-user-name { font-size: .85rem; font-weight: 600; }

        /* ── TOPBAR USER DROPDOWN ── */
        .topbar-user-wrapper { position: relative; }
        .topbar-user-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 210px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            padding: 6px;
            display: none;
            z-index: 200;
        }
        .topbar-user-menu.open { display: block; }
        .topbar-menu-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            font-size: .85rem;
            font-weight: 500;
            color: var(--text-primary);
            transition: background .15s;
            cursor: pointer;
        }
        .topbar-menu-item svg { width: 15px; height: 15px; flex-shrink: 0; }
        .topbar-menu-item:hover { background: var(--surface-2); }
        .topbar-menu-item.danger { color: var(--danger); }
        .topbar-menu-item.danger:hover { background: rgba(239,68,68,.08); }
        .topbar-menu-divider { height: 1px; background: var(--border); margin: 6px 4px; }

        /* ── TOPBAR NOTIFICATIONS DROPDOWN (NOUVEAU) ── */
        .topbar-notif-wrapper { position: relative; }
        .topbar-notif-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 360px;
            max-width: 90vw;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            display: none;
            z-index: 300;
            overflow: hidden;
        }
        .topbar-notif-menu.open { display: block; }
        .notif-menu-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
        }
        .notif-menu-header strong { font-size: .88rem; font-weight: 700; color: var(--text-primary); }
        .notif-mark-all-btn {
            font-size: .74rem;
            font-weight: 600;
            color: var(--accent);
            background: none;
            border: none;
            cursor: pointer;
        }
        .notif-mark-all-btn:hover { text-decoration: underline; }
        .notif-menu-list { max-height: 380px; overflow-y: auto; }
        .notif-item {
            display: flex;
            gap: 10px;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: background .15s;
            text-align: left;
        }
        .notif-item:last-child { border-bottom: none; }
        .notif-item:hover { background: var(--surface-2); }
        .notif-item.unread { background: rgba(99,102,241,.05); }
        .notif-item-icon {
            width: 34px; height: 34px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }
        .notif-item-icon.accent { background: rgba(99,102,241,.1); }
        .notif-item-icon.success { background: rgba(34,197,94,.1); }
        .notif-item-icon.warning { background: rgba(245,158,11,.1); }
        .notif-item-icon.info { background: rgba(59,130,246,.1); }
        .notif-item-content { flex: 1; min-width: 0; }
        .notif-item-title {
            font-size: .82rem; font-weight: 700; color: var(--text-primary);
            margin-bottom: 2px; display: flex; align-items: center; gap: 6px;
        }
        .notif-item-title .unread-dot {
            width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex-shrink: 0;
        }
        .notif-item-message { font-size: .78rem; color: var(--text-secondary); line-height: 1.4; }
        .notif-item-time { font-size: .7rem; color: var(--text-muted); margin-top: 4px; }
        .notif-menu-empty { padding: 32px 16px; text-align: center; font-size: .82rem; color: var(--text-muted); }
        .notif-menu-footer {
            display: block;
            text-align: center;
            padding: 11px;
            font-size: .8rem;
            font-weight: 600;
            color: var(--accent);
            border-top: 1px solid var(--border);
        }
        .notif-menu-footer:hover { background: var(--surface-2); }

        /* ── PAGE CONTENT ── */
        .page-content { padding: 28px; flex: 1; }
        body.admin-shell .page-content { position: relative; z-index: 1; }

        /* ── STAT CARDS ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 20px;
            box-shadow: var(--shadow-sm);
        }
        body.admin-shell .stat-card,
        body.admin-shell .card,
        body.admin-shell .offer-card {
            background: linear-gradient(180deg, rgba(15,23,42,.88), rgba(15,23,42,.72));
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 20px 50px rgba(2,6,23,.24);
            backdrop-filter: blur(16px);
        }
        body.admin-shell .stat-card:hover,
        body.admin-shell .card:hover,
        body.admin-shell .offer-card:hover {
            border-color: rgba(34,211,238,.24);
            box-shadow: 0 24px 60px rgba(2,6,23,.34);
        }
        .stat-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }
        .stat-card-label {
            font-size: .78rem;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .04em;
        }
        .stat-card-icon {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .stat-card-icon.accent { background: rgba(99,102,241,.1); color: var(--accent); }
        .stat-card-icon.success { background: rgba(34,197,94,.1); color: var(--success); }
        .stat-card-icon.warning { background: rgba(245,158,11,.1); color: var(--warning); }
        .stat-card-icon.info { background: rgba(59,130,246,.1); color: #3b82f6; }
        .stat-card-value {
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -.5px;
            line-height: 1;
        }
        .stat-card-trend {
            font-size: .75rem;
            color: var(--success);
            font-weight: 600;
            margin-top: 4px;
        }
        .stat-card-trend.down { color: var(--danger); }

        /* ── CARDS ── */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
        }
        body.admin-shell .card {
            position: relative;
            overflow: hidden;
        }
        body.admin-shell .card::before,
        body.admin-shell .stat-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(34,211,238,.08), transparent 34%, rgba(251,113,133,.05));
            pointer-events: none;
        }
        .card-header {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .card-title {
            font-size: .95rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .card-subtitle {
            font-size: .78rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }
        .card-body { padding: 20px; }

        /* ── SEARCH BAR ── */
        .search-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }
        body.admin-shell .search-bar {
            padding: 14px;
            border: 1px solid rgba(148,163,184,.16);
            border-radius: 20px;
            background: rgba(15,23,42,.7);
            backdrop-filter: blur(16px);
            box-shadow: 0 18px 50px rgba(2,6,23,.2);
        }
        .search-input-wrap {
            flex: 1;
            position: relative;
        }
        .search-input-wrap input {
            width: 100%;
            padding: 10px 14px 10px 40px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: .88rem;
            background: var(--surface);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            color: var(--text-primary);
        }
        .search-input-wrap input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }
        .search-input-wrap svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            width: 16px;
            height: 16px;
        }
        .filter-select {
            padding: 9px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: .85rem;
            background: var(--surface);
            color: var(--text-primary);
            outline: none;
            cursor: pointer;
            transition: border-color .2s;
        }
        .filter-select:focus { border-color: var(--accent); }

        body.admin-shell .search-input-wrap input,
        body.admin-shell .filter-select,
        body.admin-shell .form-control {
            background: rgba(2,6,23,.42);
            border-color: rgba(148,163,184,.16);
            color: var(--text-primary);
        }

        body.admin-shell .search-input-wrap input::placeholder,
        body.admin-shell .form-control::placeholder {
            color: rgba(203,213,225,.55);
        }

        body.admin-shell .search-input-wrap input:focus,
        body.admin-shell .filter-select:focus,
        body.admin-shell .form-control:focus {
            border-color: rgba(34,211,238,.5);
            box-shadow: 0 0 0 3px rgba(34,211,238,.12);
        }

        /* ── BADGES / TAGS ── */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
        }
        .badge-accent { background: rgba(99,102,241,.12); color: var(--accent); }
        .badge-success { background: rgba(34,197,94,.12); color: #16a34a; }
        .badge-warning { background: rgba(245,158,11,.12); color: #d97706; }
        .badge-danger { background: rgba(239,68,68,.12); color: #dc2626; }
        .badge-neutral { background: var(--surface-2); color: var(--text-secondary); border: 1px solid var(--border); }
        body.admin-shell .badge-accent { background: rgba(34,211,238,.14); color: #67e8f9; border: 1px solid rgba(34,211,238,.2); }
        body.admin-shell .badge-success { background: rgba(52,211,153,.14); color: #86efac; border: 1px solid rgba(52,211,153,.2); }
        body.admin-shell .badge-warning { background: rgba(251,191,36,.14); color: #fde68a; border: 1px solid rgba(251,191,36,.2); }
        body.admin-shell .badge-danger { background: rgba(251,113,133,.14); color: #fda4af; border: 1px solid rgba(251,113,133,.2); }
        body.admin-shell .badge-neutral { background: rgba(15,23,42,.65); color: #cbd5e1; border: 1px solid rgba(148,163,184,.18); }
        body.candidate-shell .badge-accent { background: rgba(249,115,22,.14); color: #ea580c; border: 1px solid rgba(249,115,22,.18); }
        body.candidate-shell .badge-success { background: rgba(16,185,129,.12); color: #047857; border: 1px solid rgba(16,185,129,.18); }
        body.candidate-shell .badge-warning { background: rgba(245,158,11,.14); color: #b45309; border: 1px solid rgba(245,158,11,.18); }
        body.candidate-shell .badge-danger { background: rgba(239,68,68,.12); color: #b91c1c; border: 1px solid rgba(239,68,68,.18); }
        body.candidate-shell .badge-neutral { background: rgba(255,255,255,.78); color: #475569; border: 1px solid rgba(148,163,184,.18); }
        .tag {
            display: inline-block;
            padding: 3px 10px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: .75rem;
            font-weight: 500;
            color: var(--text-secondary);
        }

        /* ── MATCH SCORE BADGE ── */
        .match-score {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 700;
        }
        .match-score.high { background: rgba(34,197,94,.12); color: #16a34a; border: 1.5px solid rgba(34,197,94,.25); }
        .match-score.mid { background: rgba(245,158,11,.12); color: #d97706; border: 1.5px solid rgba(245,158,11,.25); }
        .match-score.low { background: rgba(239,68,68,.12); color: #dc2626; border: 1.5px solid rgba(239,68,68,.25); }
        /* ── SCORE IA TOOLTIP (rapport IA au survol) ── */
        .score-tooltip-wrapper {
            position: relative;
            display: inline-block;
            cursor: help;
        }
        .score-tooltip-content {
            display: none;
            position: absolute;
            bottom: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%);
            width: 280px;
            background: #0f172a;
            color: #e2e8f0;
            border-radius: var(--radius-md);
            padding: 14px 16px;
            font-size: .78rem;
            line-height: 1.5;
            box-shadow: var(--shadow-lg);
            z-index: 500;
            text-align: left;
        }
        .score-tooltip-content::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: #0f172a;
        }
        .score-tooltip-wrapper:hover .score-tooltip-content,
        .score-tooltip-wrapper:focus-within .score-tooltip-content {
            display: block;
        }
        .score-tooltip-title {
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
            font-size: .82rem;
        }
        .score-tooltip-section { margin-bottom: 10px; }
        .score-tooltip-section:last-child { margin-bottom: 0; }
        .score-tooltip-label {
            font-weight: 700;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .score-tooltip-label.matched { color: #86efac; }
        .score-tooltip-label.missing { color: #fca5a5; }
        .score-tooltip-chips { display: flex; flex-wrap: wrap; gap: 4px; }
        .score-tooltip-chip {
            background: rgba(255,255,255,.08);
            padding: 2px 8px;
            border-radius: 999px;
            font-size: .72rem;
        }
        .score-tooltip-chip.matched { background: rgba(34,197,94,.18); color: #86efac; }
        .score-tooltip-chip.missing { background: rgba(239,68,68,.18); color: #fca5a5; }
        .score-tooltip-empty { color: #94a3b8; font-style: italic; font-size: .74rem; }

        /* ── FLASH MESSAGES ── */
        .flash-container { padding: 0 28px; }
        .flash {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            font-size: .86rem;
            font-weight: 500;
            margin-bottom: 16px;
        }
        .flash-success { background: rgba(34,197,94,.1); color: #15803d; border: 1px solid rgba(34,197,94,.25); }
        .flash-error   { background: rgba(239,68,68,.1); color: #b91c1c; border: 1px solid rgba(239,68,68,.25); }
        .flash-info    { background: rgba(99,102,241,.1); color: #4338ca; border: 1px solid rgba(99,102,241,.25); }

        /* ── OFFER CARD ── */
        .offer-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 20px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow .2s, border-color .2s, transform .15s;
            display: flex;
            gap: 16px;
            align-items: flex-start;
            margin-bottom: 12px;
        }
        .offer-card:hover {
            box-shadow: var(--shadow-md);
            border-color: rgba(99,102,241,.3);
            transform: translateY(-1px);
        }
        .offer-logo {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--accent), #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: .9rem;
            color: #fff;
            flex-shrink: 0;
        }
        .offer-info { flex: 1; min-width: 0; }
        .offer-title { font-size: .95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 3px; }
        .offer-company { font-size: .82rem; color: var(--text-secondary); margin-bottom: 8px; }
        .offer-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            font-size: .78rem;
            color: var(--text-muted);
            margin-bottom: 10px;
        }
        .offer-meta-item { display: flex; align-items: center; gap: 4px; }
        .offer-meta-item svg { width: 13px; height: 13px; }
        .offer-salary {
            display: inline-block;
            padding: 3px 10px;
            background: rgba(34,197,94,.1);
            color: #15803d;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
        }
        .offer-tags { display: flex; flex-wrap: wrap; gap: 6px; }
        .offer-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }
        .offer-date { font-size: .75rem; color: var(--text-muted); }

        /* ── TABLE ── */
        .data-table { width: 100%; border-collapse: collapse; }
        body.admin-shell .data-table { overflow: hidden; border-radius: 18px; }
        .data-table th {
            padding: 11px 16px;
            text-align: left;
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border);
        }
        .data-table td {
            padding: 14px 16px;
            font-size: .86rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }
        .data-table tr:last-child td { border-bottom: none; }
        .data-table tr:hover td { background: var(--surface-2); }
        body.admin-shell .data-table th {
            background: rgba(15,23,42,.72);
            color: #e2e8f0;
            border-bottom-color: rgba(148,163,184,.16);
        }
        body.admin-shell .data-table td { border-bottom-color: rgba(148,163,184,.12); }
        body.admin-shell .data-table tr:hover td { background: rgba(34,211,238,.06); }
        body.candidate-shell .sidebar {
            border-right: 1px solid rgba(251,146,60,.10);
            box-shadow: 10px 0 30px rgba(15,23,42,.05);
            backdrop-filter: blur(18px);
            color: #1f2937;
        }
        body.candidate-shell .sidebar-logo,
        body.candidate-shell .sidebar-footer { border-color: rgba(148,163,184,.12); }
        body.candidate-shell .sidebar-logo-text strong,
        body.candidate-shell .sidebar-user-info strong { color: #111827; }
        body.candidate-shell .sidebar-logo-text small,
        body.candidate-shell .sidebar-user-info small,
        body.candidate-shell .sidebar-section-label,
        body.candidate-shell .sidebar-nav-item { color: #475569; }
        body.candidate-shell .sidebar-nav-item:hover { background: rgba(249,115,22,.08); color: #111827; transform: translateX(3px); }
        body.candidate-shell .sidebar-nav-item.active { background: linear-gradient(135deg, rgba(249,115,22,.14), rgba(59,130,246,.10)); color: #ea580c; box-shadow: inset 0 0 0 1px rgba(249,115,22,.18); }
        body.candidate-shell .sidebar-avatar,
        body.candidate-shell .sidebar-logo-icon { background: linear-gradient(135deg, #f97316, #fb7185 55%, #3b82f6); box-shadow: 0 12px 24px rgba(249,115,22,.18); }
        body.candidate-shell .topbar {
            background: rgba(255,255,255,.5);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(148,163,184,.12);
            box-shadow: 0 8px 24px rgba(15,23,42,.06);
        }
        body.candidate-shell .page-content { position: relative; z-index: 1; }
        body.candidate-shell .stat-card,
        body.candidate-shell .card,
        body.candidate-shell .offer-card,
        body.candidate-shell .choice-card {
            background: linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,247,237,.84));
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 18px 44px rgba(15,23,42,.08);
            backdrop-filter: blur(14px);
        }
        body.candidate-shell .card::before,
        body.candidate-shell .stat-card::before,
        body.candidate-shell .offer-card::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(135deg, rgba(249,115,22,.06), transparent 40%, rgba(59,130,246,.04));
        }
        body.candidate-shell .stat-card:hover,
        body.candidate-shell .card:hover,
        body.candidate-shell .offer-card:hover,
        body.candidate-shell .choice-card:hover {
            border-color: rgba(249,115,22,.26);
            box-shadow: 0 22px 52px rgba(15,23,42,.12);
        }
        body.candidate-shell .search-bar {
            padding: 14px;
            border-radius: 22px;
            background: rgba(255,255,255,.74);
            border: 1px solid rgba(148,163,184,.16);
            box-shadow: 0 16px 40px rgba(15,23,42,.06);
        }
        body.candidate-shell .search-input-wrap input,
        body.candidate-shell .filter-select,
        body.candidate-shell .form-control {
            background: rgba(255,255,255,.88);
            border-color: rgba(148,163,184,.16);
            color: #111827;
        }
        body.candidate-shell .search-input-wrap input:focus,
        body.candidate-shell .filter-select:focus,
        body.candidate-shell .form-control:focus {
            border-color: rgba(249,115,22,.45);
            box-shadow: 0 0 0 3px rgba(249,115,22,.10);
        }
        body.candidate-shell .btn-primary {
            background: linear-gradient(135deg, #fb7185 0%, #f97316 55%, #f59e0b 100%);
            color: #fff;
            box-shadow: 0 16px 28px rgba(249,115,22,.22);
        }
        body.candidate-shell .btn-primary:hover { box-shadow: 0 20px 36px rgba(249,115,22,.28); transform: translateY(-1px); }
        body.candidate-shell .btn-secondary {
            background: rgba(255,255,255,.84);
            color: #111827;
            border-color: rgba(148,163,184,.18);
        }
        body.candidate-shell .btn-secondary:hover { background: rgba(249,115,22,.08); border-color: rgba(249,115,22,.25); }

        /* ── AVATAR GROUP ── */
        .avatar-group { display: flex; }
        .avatar-group .av {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 2px solid var(--surface);
            margin-left: -8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .7rem;
            font-weight: 700;
            color: #fff;
        }
        .avatar-group .av:first-child { margin-left: 0; }
        .avatar-group .av-more {
            background: var(--surface-2);
            color: var(--text-secondary);
            border-color: var(--border);
            font-size: .68rem;
        }

        /* ── CHOICE CARDS (inscription) ── */
        .choice-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 8px;
        }
        .choice-card {
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            padding: 28px 20px;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: block;
        }
        .choice-card:hover {
            border-color: var(--accent);
            background: var(--accent-glow);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }
        .choice-card-icon {
            width: 52px;
            height: 52px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 1.5rem;
        }
        .choice-card-icon.candidat { background: rgba(99,102,241,.1); }
        .choice-card-icon.entreprise { background: rgba(245,158,11,.1); }
        .choice-card h3 { font-size: .95rem; font-weight: 700; margin-bottom: 6px; }
        .choice-card p { font-size: .8rem; color: var(--text-secondary); line-height: 1.5; }

        /* ── PAGINATION ── */
        .pagination {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            justify-content: flex-end;
        }
        .page-btn {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--surface);
            font-size: .82rem;
            font-weight: 600;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .15s;
        }
        .page-btn:hover, .page-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        /* ── UTILS ── */
        .text-accent { color: var(--accent); }
        .text-muted { color: var(--text-muted); }
        .text-secondary { color: var(--text-secondary); }
        .font-bold { font-weight: 700; }
        .font-medium { font-weight: 500; }
        .text-sm { font-size: .82rem; }
        .text-xs { font-size: .74rem; }
        .flex { display: flex; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-2 { gap: 8px; }
        .gap-3 { gap: 12px; }
        .mt-1 { margin-top: 4px; }
        .mt-2 { margin-top: 8px; }
        .mt-3 { margin-top: 12px; }
        .mt-4 { margin-top: 16px; }
        .mb-2 { margin-bottom: 8px; }
        .mb-3 { margin-bottom: 12px; }
        .mb-4 { margin-bottom: 16px; }
        .mb-6 { margin-bottom: 24px; }
        .w-full { width: 100%; }
        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        .section-subtitle {
            font-size: .82rem;
            color: var(--text-secondary);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
