{# ── script des dropdowns top-right (compte + notifications) : uniquement ──
   ── quand le layout sidebar est réellement rendu ── #}
{% if app.user and not is_face_id_verify_page %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var wrapper = document.getElementById('topbar-user-wrapper');
    var toggle  = document.getElementById('topbar-user-toggle');
    var menu    = document.getElementById('topbar-user-menu');

    if (wrapper && toggle && menu) {
        toggle.addEventListener('click', function (e) {
            e.stopPropagation();
            menu.classList.toggle('open');
        });
    }

    // ── Dropdown Notifications ──────────────────────────────────────
    var notifWrapper = document.getElementById('topbar-notif-wrapper');
    var notifToggle  = document.getElementById('topbar-notif-toggle');
    var notifMenu    = document.getElementById('topbar-notif-menu');
    var notifList    = document.getElementById('notif-menu-list');
    var notifDot     = document.getElementById('topbar-notif-dot');
    var notifMarkAll = document.getElementById('notif-mark-all-btn');

    var CSRF_MARK_READ     = '{{ csrf_token("notification_mark_read") }}';
    var CSRF_MARK_ALL_READ = '{{ csrf_token("notification_mark_all_read") }}';

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str == null ? '' : str;
        return div.innerHTML;
    }

    function renderNotifications(data) {
        if (!data.notifications || data.notifications.length === 0) {
            notifList.innerHTML = '<div class="notif-menu-empty">Aucune notification pour le moment.</div>';
            return;
        }
        var html = '';
        data.notifications.forEach(function (n) {
            html += '<div class="notif-item' + (n.lu ? '' : ' unread') + '" data-id="' + n.id + '" data-lien="' + (n.lien || '') + '">'
                + '<div class="notif-item-icon ' + n.color + '">' + n.icon + '</div>'
                + '<div class="notif-item-content">'
                + '<div class="notif-item-title">' + (n.lu ? '' : '<span class="unread-dot"></span>') + escapeHtml(n.titre) + '</div>'
                + '<div class="notif-item-message">' + escapeHtml(n.message) + '</div>'
                + '<div class="notif-item-time">' + escapeHtml(n.date) + '</div>'
                + '</div></div>';
        });
        notifList.innerHTML = html;

        notifList.querySelectorAll('.notif-item').forEach(function (item) {
            item.addEventListener('click', function () {
                markOneAsRead(item.dataset.id, item.dataset.lien);
            });
        });
    }

    function updateDot(count) {
        if (!notifDot) return;
        notifDot.style.display = count > 0 ? 'block' : 'none';
    }

    function loadPanel() {
        fetch('/notifications/panel', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                renderNotifications(data);
                updateDot(data.unread_count);
            })
            .catch(function () {
                notifList.innerHTML = '<div class="notif-menu-empty">Erreur de chargement.</div>';
            });
    }

    function markOneAsRead(id, lien) {
        fetch('/notifications/' + id + '/lire', {
            method: 'POST',
            headers: { 'X-CSRF-Token': CSRF_MARK_READ },
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                updateDot(data.unread_count || 0);
                if (lien) {
                    window.location.href = lien;
                } else {
                    loadPanel();
                }
            })
            .catch(function () {});
    }

    if (notifWrapper && notifToggle && notifMenu) {
        notifToggle.addEventListener('click', function (e) {
            e.stopPropagation();
            var willOpen = !notifMenu.classList.contains('open');
            notifMenu.classList.toggle('open');
            if (menu) menu.classList.remove('open');
            if (willOpen) {
                notifList.innerHTML = '<div class="notif-menu-empty">Chargement…</div>';
                loadPanel();
            }
        });
    }

    if (notifMarkAll) {
        notifMarkAll.addEventListener('click', function (e) {
            e.stopPropagation();
            fetch('/notifications/lire-tout', {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_MARK_ALL_READ },
            })
                .then(function (r) { return r.json(); })
                .then(function () {
                    updateDot(0);
                    loadPanel();
                })
                .catch(function () {});
        });
    }

    document.addEventListener('click', function (e) {
        if (wrapper && !wrapper.contains(e.target) && menu) {
            menu.classList.remove('open');
        }
        if (notifWrapper && !notifWrapper.contains(e.target) && notifMenu) {
            notifMenu.classList.remove('open');
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            if (menu) menu.classList.remove('open');
            if (notifMenu) notifMenu.classList.remove('open');
        }
    });
});
</script>
{% endif %}

{% block javascripts %}{% endblock %}
</body>
</html>