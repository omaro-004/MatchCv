{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}
{% block page_subtitle %}{{ app.user.profilEntreprise is not null ? app.user.profilEntreprise.raisonSociale : 'Espace recruteur' }} · Statistiques en temps réel{% endblock %}

{% block body %}

<div style="display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-bottom:20px;flex-wrap:wrap;">
    <a href="{{ path('app_entreprise_dashboard_export_pdf') }}" class="btn btn-secondary btn-sm" style="gap:6px;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Exporter en PDF
    </a>
    <a href="{{ path('app_entreprise_dashboard_export_excel') }}" class="btn btn-secondary btn-sm" style="gap:6px;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 8l8 8m0-8l-8 8"/></svg>
        Exporter en Excel
    </a>
</div>

{# ── KPI CARDS ── #}
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Offres actives</span>
            <div class="stat-card-icon warning">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 13.255A23.931 23.931 0 0 1 12 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2m4 6h.01M5 20h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.offres_actives }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">{{ stats.offres_archivees }} offre{{ stats.offres_archivees > 1 ? 's' : '' }} archivée{{ stats.offres_archivees > 1 ? 's' : '' }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Candidatures totales</span>
            <div class="stat-card-icon accent">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.candidatures_totales }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">Toutes offres confondues</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Score moyen matching</span>
            <div class="stat-card-icon success">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/></svg>
            </div>
        </div>
        <div class="stat-card-value">{{ stats.score_matching_moyen is not null ? stats.score_matching_moyen ~ '%' : '—' }}</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">{{ stats.score_matching_moyen is not null ? 'Basé sur les candidatures scorées' : 'Aucune candidature scorée' }}</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-header">
            <span class="stat-card-label">Événements à venir</span>
            <div class="stat-card-icon info">
                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
        </div>
        <div class="stat-card-value">—</div>
        <div class="stat-card-trend" style="color:var(--text-muted);">Module Événements à venir</div>
    </div>
</div>

{# ── CHARTS ── #}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-bottom:24px;">

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Offres par type de contrat</div>
        {% if stats.offres_actives > 0 %}
            <canvas id="chart-type-contrat" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Aucune offre active pour le moment</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Offres par mode de travail</div>
        {% if stats.offres_actives > 0 %}
            <canvas id="chart-mode-travail" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Aucune offre active pour le moment</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;">
        <div class="card-title" style="margin-bottom:16px;">Candidatures par statut</div>
        {% if stats.candidatures_totales > 0 %}
            <canvas id="chart-candidatures-statut" height="220"></canvas>
        {% else %}
            <div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem;">Aucune candidature reçue pour le moment</div>
        {% endif %}
    </div>

    <div class="card" style="padding:20px;grid-column:1 / -1;">
        <div class="card-title" style="margin-bottom:16px;">Évolution des publications d'offres (6 derniers mois)</div>
        <canvas id="chart-publications" height="90"></canvas>
    </div>

</div>

{# ── TOP OFFRES ── #}
<div class="card">
    <div class="card-header">
        <div>
            <div class="card-title">Top offres par candidatures reçues</div>
            <div class="card-subtitle">Vos offres les plus populaires</div>
        </div>
    </div>
    {% if stats.top_offres|length > 0 %}
        <table class="data-table">
            <thead>
                <tr><th>Offre</th><th>Candidatures</th></tr>
            </thead>
            <tbody>
                {% for offre in stats.top_offres %}
                <tr>
                    <td style="font-weight:600;">{{ offre.titre }}</td>
                    <td>{{ offre.total }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div style="padding:32px 20px;text-align:center;color:var(--text-muted);font-size:.85rem;">Aucune candidature reçue pour le moment.</div>
    {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const PALETTE = ['#6366f1', '#22c55e', '#f59e0b', '#3b82f6', '#ec4899', '#a855f7'];

    const typeContratData        = {{ stats.offres_par_type_contrat|json_encode|raw }};
    const modeTravailData        = {{ stats.offres_par_mode_travail|json_encode|raw }};
    const candidaturesStatutData = {{ stats.candidatures_par_statut|json_encode|raw }};
    const moisData                = {{ stats.publications_par_mois|json_encode|raw }};

    const TYPE_CONTRAT_LABELS = { stage: 'Stage', emploi: 'Emploi' };
    const MODE_TRAVAIL_LABELS = { sur_site: 'Sur site', teletravail: 'Télétravail', hybride: 'Hybride' };
    const STATUT_LABELS       = { en_attente: 'En attente', accepte: 'Accepté', refuse: 'Refusé' };

    function renderPie(canvasId, dataObj, labelsMap) {
        const el = document.getElementById(canvasId);
        if (!el) return;
        const keys = Object.keys(dataObj);
        new Chart(el, {
            type: 'doughnut',
            data: {
                labels: keys.map(k => labelsMap[k] || k),
                datasets: [{ data: keys.map(k => dataObj[k]), backgroundColor: PALETTE, borderWidth: 0 }],
            },
            options: {
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } } },
                cutout: '60%',
            },
        });
    }

    renderPie('chart-type-contrat', typeContratData, TYPE_CONTRAT_LABELS);
    renderPie('chart-mode-travail', modeTravailData, MODE_TRAVAIL_LABELS);
    renderPie('chart-candidatures-statut', candidaturesStatutData, STATUT_LABELS);

    const moisKeys = Object.keys(moisData);
    const moisNoms = ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'];
    const moisLabels = moisKeys.map(m => {
        const parts = m.split('-');
        return moisNoms[parseInt(parts[1], 10) - 1] + ' ' + parts[0];
    });

    new Chart(document.getElementById('chart-publications'), {
        type: 'bar',
        data: {
            labels: moisLabels,
            datasets: [{
                label: 'Offres publiées',
                data: moisKeys.map(m => moisData[m]),
                backgroundColor: '#6366f1',
                borderRadius: 6,
                maxBarThickness: 36,
            }],
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } } },
        },
    });
})();
</script>

{% endblock %}