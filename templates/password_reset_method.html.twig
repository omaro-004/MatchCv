{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block auth_body %}
<div class="auth-wrapper">
    <div class="auth-card">

        <div style="margin-bottom:24px;">
            <div style="width:48px;height:48px;background:rgba(34,197,94,.1);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;">
                <svg width="22" height="22" fill="none" stroke="var(--success)" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div style="font-size:1.1rem;font-weight:800;color:var(--text-primary);margin-bottom:4px;">Compte trouvé</div>
            <div style="font-size:.84rem;color:var(--text-secondary);line-height:1.5;">Choisissez comment réinitialiser votre mot de passe.</div>
        </div>

        <form method="post" action="{{ path('app_password_reset_send_email') }}" style="margin-bottom:12px;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_send_email') }}">
            <button type="submit" class="btn btn-primary btn-full btn-lg" style="justify-content:flex-start;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg>
                Recevoir un lien par email
                {% if masked_email is defined %}<span style="margin-left:auto;font-weight:400;opacity:.85;">{{ masked_email }}</span>{% endif %}
            </button>
        </form>

        {% if totp_available %}
            <a href="{{ path('app_password_reset_totp_verify') }}" class="btn btn-secondary btn-full btn-lg" style="margin-bottom:12px;justify-content:flex-start;">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                Utiliser mon application d'authentification
            </a>
        {% endif %}

        <div style="text-align:center;margin-top:12px;">
            <a href="{{ path('app_forgot_password') }}" style="font-size:.82rem;color:var(--text-muted);">Ce n'est pas mon compte ?</a>
        </div>

    </div>
</div>
{% endblock %}