{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}
{% block page_title %}Notifications{% endblock %}
{% block page_subtitle %}{{ notifications|length }} notification{{ notifications|length > 1 ? 's' : '' }} récente{{ notifications|length > 1 ? 's' : '' }}{% endblock %}

{% block body %}

<div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
    <button type="button" id="notif-page-mark-all" class="btn btn-secondary btn-sm">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        Tout marquer comme lu
    </button>
</div>

{% if notifications|length == 0 %}
    <div class="card" style="padding:48px 24px;text-align:center;">
        <div style="font-size:2rem;margin-bottom:12px;">🔔</div>
        <div style="font-weight:700;font-size:1rem;margin-bottom:6px;">Aucune notification pour le moment</div>
        <div style="color:var(--text-secondary);font-size:.85rem;">Vous serez notifié ici dès qu'une action concernera votre compte.</div>
    </div>
{% else %}
    <div class="card" style="overflow:hidden;">
        {% for n in notifications %}
            <div class="notif-item{{ n.lu ? '' : ' unread' }}" data-id="{{ n.id }}" data-lien="{{ n.lien }}" style="cursor:{{ n.lien ? 'pointer' : 'default' }};">
                <div class="notif-item-icon {{ n.typeColorClass }}">{{ n.typeIcon }}</div>
                <div class="notif-item-content">
                    <div class="notif-item-title">
                        {% if not n.lu %}<span class="unread-dot"></span>{% endif %}
                        {{ n.titre }}
                    </div>
                    <div class="notif-item-message">{{ n.message }}</div>
                    <div class="notif-item-time">{{ n.dateEnvoi ? n.dateEnvoi|date('d/m/Y à H:i') : '' }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<script>
(function () {
    const CSRF_MARK_READ     = '{{ csrf_token("notification_mark_read") }}';
    const CSRF_MARK_ALL_READ = '{{ csrf_token("notification_mark_all_read") }}';

    document.querySelectorAll('.notif-item').forEach(function (item) {
        item.addEventListener('click', function () {
            const id = item.dataset.id;
            const lien = item.dataset.lien;

            fetch('/notifications/' + id + '/lire', {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_MARK_READ },
            })
                .then(function (r) { return r.json(); })
                .then(function () {
                    if (lien) {
                        window.location.href = lien;
                    } else {
                        item.classList.remove('unread');
                        const dot = item.querySelector('.unread-dot');
                        if (dot) dot.remove();
                    }
                })
                .catch(function () {});
        });
    });

    const btnMarkAll = document.getElementById('notif-page-mark-all');
    if (btnMarkAll) {
        btnMarkAll.addEventListener('click', function () {
            fetch('/notifications/lire-tout', {
                method: 'POST',
                headers: { 'X-CSRF-Token': CSRF_MARK_ALL_READ },
            })
                .then(function (r) { return r.json(); })
                .then(function () { window.location.reload(); })
                .catch(function () {});
        });
    }
})();
</script>

{% endblock %}